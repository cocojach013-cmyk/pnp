    <!-- ===== Script principal ===== -->
    <script>
        (function(){
          // ===== Refs =====
          const criterio=document.getElementById('criterio');
          const valorWrap=document.getElementById('valorWrap');
          const valor=document.getElementById('valor');
          const huellaWrap=document.getElementById('huellaWrap');
          const huellaEstado=document.getElementById('huellaEstado');
          const huellaBase64=document.getElementById('huellaBase64');

          const form=document.getElementById('buscadorForm');
          const result=document.getElementById('resultCard');
          const resFoto=document.getElementById('resFoto');
          const resGrado=document.getElementById('resGrado');
          const resNombre=document.getElementById('resNombre');
          const resUnidad=document.getElementById('resUnidad');

          const btnReg=document.getElementById('btnRegistrarAsistencia');
          const okHoy=document.getElementById('okHoy');
          const msgBox=document.getElementById('msgBox');
          const btnNuevo=document.getElementById('btnNuevo');

          const accionesTop=document.getElementById('accionesTop');
          const accionesPostEntrada=document.getElementById('accionesPostEntrada');
          const btnRegistrarSalida=document.getElementById('btnRegistrarSalida');
          const btnRegistrarRetorno=document.getElementById('btnRegistrarRetorno');
          const btnOpenMovModal=document.getElementById('btnShowMovModal');

          const cyclesWrap=document.getElementById('cyclesWrap');
          const cyclesTbody=document.getElementById('cyclesTbody');
          const movPendWrap=document.getElementById('movPendWrap');
          const movPendTbody=document.getElementById('movPendTbody');
          const openAsisWrap=document.getElementById('openAsisWrap');
          const openAsisTbody=document.getElementById('openAsisTbody');

          // Toggles: Asistencias del día
          const hoyCountLine=document.getElementById('hoyCountLine');
          const hoyCount=document.getElementById('hoyCount');
          const toggleCyclesBtn=document.getElementById('toggleCyclesBtn');
          const toggleHint=document.getElementById('toggleHint');

          // Toggles: Movimientos del día
          const movTodayCountLine=document.getElementById('movTodayCountLine');
          const movTodayCount=document.getElementById('movTodayCount');
          const toggleMovTodayBtn=document.getElementById('toggleMovTodayBtn');
          const toggleMovTodayHint=document.getElementById('toggleMovTodayHint');
          const movTodayWrap=document.getElementById('movTodayWrap');
          const movTodayTbody=document.getElementById('movTodayTbody');

          if(toggleCyclesBtn){
            toggleCyclesBtn.addEventListener('click', ()=>{
              const hidden=cyclesWrap.classList.contains('d-none');
              cyclesWrap.classList.toggle('d-none');
              if(toggleHint) toggleHint.textContent = hidden ? '(clic para ocultar)' : '(clic para ver)';
            });
          }
          if(toggleMovTodayBtn){
            toggleMovTodayBtn.addEventListener('click', ()=>{
              const hidden=movTodayWrap.classList.contains('d-none');
              movTodayWrap.classList.toggle('d-none');
              if(toggleMovTodayHint) toggleMovTodayHint.textContent = hidden ? '(clic para ocultar)' : '(clic para ver)';
            });
          }

          // ===== Status modal util =====
          const statusModalEl=document.getElementById('statusModal');
          const statusModal = statusModalEl ? new bootstrap.Modal(statusModalEl) : null;
          const statusTitle=document.getElementById('statusModalTitle');
          const statusBody=document.getElementById('statusModalBody');
          const statusContent=statusModalEl ? statusModalEl.querySelector('.modal-content'):null;
          let statusTimer=null;

          function fmtHMSFromSeconds(totalSeconds){
            if(isNaN(totalSeconds)||totalSeconds<0) totalSeconds=0;
            const h=Math.floor(totalSeconds/3600), m=Math.floor((totalSeconds%3600)/60), s=Math.floor(totalSeconds%60);
            return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
          }
          function fmtElapsed(ms){
            if(ms<0) ms=0; const sec=Math.floor(ms/1000);
            const d=Math.floor(sec/86400), h=Math.floor((sec%86400)/3600), m=Math.floor((sec%3600)/60), s=sec%60;
            const hh=String(h).padStart(2,'0'), mm=String(m).padStart(2,'0'), ss=String(s).padStart(2,'0');
            return d>0?`${d}d ${hh}:${mm}:${ss}`:`${hh}:${mm}:${ss}`;
          }
          function showStatusModal({title,html,type='info',autoCloseMs=1800}){
            if(!statusModal) return;
            statusModalEl.classList.remove('success-small');
            if(statusContent){
              statusContent.classList.remove('status-ok','status-late','status-info','no-header');
              if(type==='success'){
                statusContent.classList.add('status-ok','no-header'); statusModalEl.classList.add('success-small');
                html=html?`<div class="success-center"><div class="icon text-success"><i class="fa-solid fa-circle-check"></i></div><div>${html}</div></div>`:
                           `<div class="success-center"><div class="icon text-success"><i class="fa-solid fa-circle-check"></i></div><div class="fw-semibold">Operación realizada</div></div>`;
              }else if(type==='danger'){
                statusContent.classList.add('status-late','no-header'); statusModalEl.classList.add('success-small');
                html=html?`<div class="success-center"><div class="icon text-danger"><i class="fa-solid fa-circle-check"></i></div><div>${html}</div></div>`:
                           `<div class="success-center"><div class="icon text-danger"><i class="fa-solid fa-circle-check"></i></div><div class="fw-semibold">Aviso</div></div>`;
              }else{
                statusContent.classList.add('status-info');
              }
            }
            statusTitle.textContent=(type==='success'||type==='danger')?'':(title||'Estado');
            statusBody.innerHTML=html||'';
            statusModal.show(); if(statusTimer){ clearTimeout(statusTimer); }
