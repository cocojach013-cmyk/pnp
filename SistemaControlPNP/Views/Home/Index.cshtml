@{
    Layout = null;
    var placeholder = Url.Content("~/Imagenes/sin-perfil.jpg");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Control PNP – Consulta y Registro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/Style/inicio-styles.css" asp-append-version="true" />
    <style>
        /* ============================================================
                                               VARIABLES PRINCIPALES DE ESTILO
                               ============================================================ */
        :root {
            --pnp-green: #00471B;
            --pnp-green-600: #007A33;
            --pnp-green-700: #003715;
            --pnp-gold: #FFD700;
            --panel-w-sm: 200px; /* login - móvil */
            --panel-w-md: 380px; /* login - base */
            --panel-w-lg: 360px; /* login - desktop */

            --content-w: 980px;
            /* Anchos específicos de modales funcionales */
            --mov-w: 320px; /* Movimientos (más angosto) */
            --regret-w: 340px; /* Registrar / Retorno (angosto) */
            /* Alturas para barra de servicio y navbar fijo */
            --service-h: 4px;
            --header-h: 56px;
        }

        /* ============================================================
                                               BASE TIPOGRAFÍA Y CONTENEDORES
                               ============================================================ */
        body {
            font-family: "Inter", system-ui, Segoe UI, Roboto, Arial, sans-serif;
        }

        .app-wrap {
            padding-top: 1rem;
            padding-bottom: 2rem;
        }

        .search-card {
            border-radius: 1rem;
            max-width: var(--content-w);
            margin-inline: auto;
        }

            .search-card .card-body {
                max-width: 100%;
                margin-inline: auto;
                padding-left: .85rem;
                padding-right: .85rem;
                /* IMPORTANTE: sin overflow-x para que nada se corte */
            }

        #resultCard {
            max-width: var(--content-w);
            margin-inline: auto;
        }

            #resultCard .card-body {
                max-width: 100%;
                margin-inline: auto;
                padding-left: .85rem;
                padding-right: .85rem;
                font-size: .94rem;
            }

        @@media (max-width: 992px) {
            .search-card, #resultCard

        {
            max-width: 100%;
        }

        }

        .result-photo {
            width: 96px;
            height: 96px;
            object-fit: cover;
            border-radius: .5rem;
            border: 1px solid rgba(0, 0, 0, .1);
        }

        .muted-hint,
        .footer-note {
            color: #6b7280;
            font-size: .85rem;
        }

        #movPendWrap .table,
        #cyclesWrap .table,
        #openAsisWrap .table,
        #movTodayWrap .table {
            font-size: .80rem;
        }

            #movPendWrap .table td,
            #movPendWrap .table th,
            #cyclesWrap .table td,
            #cyclesWrap .table th,
            #openAsisWrap .table td,
            #openAsisWrap .table th,
            #movTodayWrap .table td,
            #movTodayWrap .table th {
                padding: .25rem .5rem;
            }

        .section-block {
            background: #fff;
            border: 1px solid rgba(0, 0, 0, .06);
            border-radius: .75rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
            padding: .75rem;
            margin-top: .5rem;
        }

        .result-top {
            display: grid;
            grid-template-columns: 110px 1fr auto;
            gap: .5rem 1rem;
            align-items: start;
        }

        .row-ident {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .45rem;
        }

            .row-ident .nombre-strong {
                font-weight: 800;
                font-size: 1.05rem;
                line-height: 1.2;
            }

        .row-unidad {
            color: #6b7280;
            font-size: .9rem;
        }

        .actions-stack {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: .35rem;
            min-width: 260px;
        }

        .result-actions-top {
            display: none;
        }

            .result-actions-top.show {
                display: flex;
                justify-content: flex-end;
                gap: .5rem;
                flex-wrap: wrap;
            }

        /* badge de “Hoy ya registrada” */
        #okHoy {
            margin-top: .10rem;
            text-align: right;
        }

        /* Responsive del bloque superior del resultado */
        @@media (max-width: 576.98px) {
            .result-top

        {
            grid-template-columns: 1fr;
        }

        .actions-stack {
            align-items: flex-start;
            min-width: auto;
            width: 100%;
        }

        #okHoy {
            text-align: left;
        }

        }

        /* ============================================================
                                               BOTONES INSTITUCIONALES
                               ============================================================ */
        .btn-pnp {
            background: linear-gradient(180deg, #0aa351, #067a3c);
            border: 1px solid #056b35;
            color: #fff;
            font-weight: 700;
        }

            .btn-pnp:hover {
                filter: saturate(1.05) brightness(1.03);
            }

        .btn-outline-pnp {
            border: 1px solid var(--pnp-green-600);
            color: var(--pnp-green-700);
            background: #fff;
        }

            .btn-outline-pnp:hover {
                background: rgba(0, 122, 51, .06);
            }

        .btn-pnp-salida {
            background: linear-gradient(180deg, #ff7a45, #d84a17);
            border: 1px solid #b13d14;
            color: #fff;
            font-weight: 800;
            border-radius: .5rem;
            box-shadow: 0 2px 6px rgba(216, 74, 23, .25);
        }

            .btn-pnp-salida:hover {
                filter: brightness(1.05);
                box-shadow: 0 0 10px rgba(216, 74, 23, .35);
            }

        .btn-pnp-mov {
            background: linear-gradient(180deg, #0d8bd7, #0869ab);
            border: 1px solid #065789;
            color: #fff;
            font-weight: 800;
            border-radius: .5rem;
            box-shadow: 0 2px 6px rgba(8, 105, 171, .25);
        }

            .btn-pnp-mov:hover {
                filter: brightness(1.06);
                box-shadow: 0 0 10px rgba(8, 105, 171, .35);
            }

        .btn-pnp-retorno {
            background: linear-gradient(180deg, #1e90ff, #0069c0);
            border: 1px solid #005aa0;
            color: #fff;
            font-weight: 800;
            border-radius: .5rem;
            box-shadow: 0 2px 6px rgba(0, 105, 192, .25);
        }

            .btn-pnp-retorno:hover {
                filter: brightness(1.08);
                box-shadow: 0 0 10px rgba(0, 105, 192, .35);
            }

        /* ============================================================
                                               NAVBAR / BRAND Y BOTÓN LOGIN
                               ============================================================ */
        .navbar .brand small {
            color: #e8d88f !important;
            font-weight: 900;
            letter-spacing: .02em;
            text-shadow: 0 1px 1px rgba(0, 0, 0, .35);
        }

        .navbar .brand span {
            color: #fff;
            font-weight: 900;
            letter-spacing: .02em;
            text-shadow: 0 1px 1px rgba(0, 0, 0, .35);
            font-size: .6rem;
        }

        .navbar .menu-link {
            color: #e8f0ea;
            text-decoration: none;
            font-weight: 500;
            font-size: .85rem;
            padding: .20rem .60rem;
            border-radius: .5rem;
            transition: .15s;
            border: 1px solid transparent;
        }

            .navbar .menu-link:hover,
            .navbar .menu-link:focus-visible {
                color: #fff;
                background: rgba(255, 255, 255, .15);
                border-color: transparent;
                box-shadow: none;
                text-decoration: none;
            }

        /* Botón “Iniciar sesión” estilo borde blanco */
        #btnAbrirLogin,
        #btnAbrirLogin:link,
        #btnAbrirLogin:visited,
        #btnAbrirLogin:hover,
        #btnAbrirLogin:focus,
        #btnAbrirLogin:active,
        .navbar #btnAbrirLogin {
            background: none !important;
            background-image: none !important;
            background-color: transparent !important;
            border: 1px solid rgba(255, 255, 255, .25) !important;
            color: #e8f0ea !important;
            box-shadow: none !important;
            filter: none !important;
        }

        #btnAbrirLogin {
            position: relative;
            overflow: hidden;
            transition: all .25s ease-in-out;
            border-radius: .5rem;
            font-weight: 700;
        }

            #btnAbrirLogin::before {
                content: "";
                position: absolute;
                top: 0;
                left: -75%;
                width: 50%;
                height: 100%;
                background: rgba(255, 255, 255, .2);
                transform: skewX(-25deg);
                transition: all .5s ease;
                pointer-events: none;
            }

            #btnAbrirLogin:hover::before {
                left: 125%;
            }

            #btnAbrirLogin:hover {
                transform: scale(1.04);
                box-shadow: 0 0 8px rgba(255, 255, 255, .2);
                color: #fff;
                border-color: rgba(255, 255, 255, .4);
            }

        /* ============================================================
                                               TABLAS / TOGGLES / FEEDBACK
                               ============================================================ */
        #openAsisWrap thead {
            background-color: var(--bs-warning-bg) !important;
        }

        #movPendWrap thead {
            background-color: var(--bs-info-bg) !important;
        }

        .toggle-line {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            cursor: pointer;
            user-select: none;
        }

            .toggle-line .counter-pill {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: .1rem .5rem;
                border-radius: 9999px;
                font-weight: 700;
                border: 1px solid rgba(0, 0, 0, .08);
                background: #f8f9fa;
            }

            .toggle-line:hover {
                filter: brightness(.98);
            }

        .invalid-feedback {
            font-size: .8rem;
            margin-top: .15rem;
        }

        #movTodayWrap .table {
            font-size: .78rem;
        }

            #movTodayWrap .table td,
            #movTodayWrap .table th {
                padding: .20rem .35rem;
            }

        #movTodayWrap .nowrap {
            white-space: nowrap;
        }

        #movTodayWrap th.w-time,
        #movTodayWrap td.w-time {
            width: 86px;
        }

        #movTodayWrap th.w-mid,
        #movTodayWrap td.w-mid {
            width: 120px;
        }

        #movTodayWrap th.w-narrow,
        #movTodayWrap td.w-narrow {
            width: 70px;
            text-align: center;
        }

        .force-uppercase,
        .force-uppercase::placeholder {
            text-transform: uppercase;
        }

        /* ============================================================
                                               MODALES — CABECERA UNIFICADA
                               ============================================================ */
        .modal-login .modal-header,
        #movModal .modal-header,
        #regModal .modal-header,
        #retModal .modal-header {
            background: linear-gradient(90deg, #002e12, #004018) !important;
            border-bottom: 3px solid var(--pnp-gold) !important;
            color: #fff !important;
            padding: .40rem .65rem !important;
            display: flex;
            align-items: center;
            gap: .45rem;
        }

        .modal-login .modal-title,
        #movModal .modal-title,
        #regModal .modal-title,
        #retModal .modal-title {
            color: #fff !important;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            font-size: .75rem;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            margin: 0;
        }

        .modal-login .btn-close,
        #movModal .btn-close,
        #regModal .btn-close,
        #retModal .btn-close {
            filter: invert(1) brightness(240%);
            opacity: .9;
        }

        /* ============================================================
                                               MODAL LOGIN - DIMENSIONES
                               ============================================================ */
        .modal-login .modal-dialog {
            max-width: var(--panel-w-md) !important;
            margin: .60rem auto !important;
        }

        @@media (min-width: 768px) {
            .modal-login .modal-dialog

        {
            max-width: var(--panel-w-lg) !important;
        }

        }

        @@media (max-width: 575.98px) {
            .modal-login .modal-dialog

        {
            max-width: var(--panel-w-sm) !important;
        }

        }

        .modal-login .modal-content {
            background: #fff;
            border-radius: .7rem;
            border: 1px solid rgba(0, 0, 0, .08);
            box-shadow: 0 6px 18px rgba(0, 0, 0, .16) !important;
            display: flex;
            flex-direction: column;
            max-height: 80vh !important;
            height: 450px;
        }

        /* ============================================================
                                               MODAL MOVIMIENTOS
                               ============================================================ */
        #movModal .modal-dialog {
            max-width: var(--mov-w) !important;
            margin: .5rem auto !important;
        }

        #movModal .modal-content {
            border-radius: .6rem;
            max-height: 75vh;
        }

        #movModal .form-label {
            margin-bottom: .2rem;
            font-weight: 600;
            color: #0f172a;
            font-size: .85rem;
        }

        #movModal .input-group-text {
            font-size: .8rem;
            padding: .25rem .5rem;
        }

        #movModal .form-control,
        #movModal .form-select {
            font-size: .8rem;
            padding: .3rem .45rem;
            line-height: 1.2;
        }

        #Mov_IdPersonal {
            display: none;
        }

        #Mov_PersonalDisplay[readonly] {
            background: #fff;
        }

        /* ============================================================
                                               MODALES REGISTRAR y RETORNO
                               ============================================================ */
        #regModal .modal-dialog,
        #retModal .modal-dialog {
            max-width: var(--regret-w) !important;
            margin: .5rem auto !important;
        }

        #regModal .modal-content,
        #retModal .modal-content {
            border-radius: .6rem;
            max-height: 75vh;
        }

        #regModal .form-label,
        #retModal .form-label {
            margin-bottom: .2rem;
            font-weight: 600;
            color: #0f172a;
            font-size: .85rem;
        }

        #regModal .input-group-text,
        #retModal .input-group-text {
            font-size: .8rem;
            padding: .25rem .5rem;
        }

        #regModal .form-control,
        #regModal .form-select,
        #retModal .form-control,
        #retModal .form-select {
            font-size: .8rem;
            padding: .3rem .45rem;
            line-height: 1.2;
        }

        #Ret_PersonalDisplay[readonly] {
            background: #fff;
        }

        /* ============================================================
                                               MODAL ESTADO (mensajes)
                               ============================================================ */
        #statusModal .modal-dialog {
            max-width: 180px;
        }

        #statusModal .modal-content {
            border-left: 6px solid transparent;
        }

        #statusModal .status-ok {
            border-left-color: #198754;
        }

        #statusModal .status-late {
            border-left-color: #dc3545;
        }

        #statusModal .status-info {
            border-left-color: #0d6efd;
        }

        #statusModal .no-header .modal-header {
            display: none;
        }

        #statusModal .no-header .modal-body {
            padding-top: 1rem;
        }

        #statusModal .success-center {
            text-align: center;
        }

            #statusModal .success-center .icon {
                font-size: 40px;
                line-height: 1;
                margin-bottom: .5rem;
            }

        /* ============================================================
                                               LAYOUT: SCROLL ÁREA FIJA
                               ============================================================ */
        .service-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--service-h);
            z-index: 1051;
        }

        .navbar.sticky-top {
            position: fixed;
            top: var(--service-h);
            left: 0;
            right: 0;
            height: var(--header-h);
            min-height: var(--header-h);
            z-index: 1050;
            display: flex;
            align-items: center;
            background: linear-gradient(90deg, #004018, #002e12);
            border-bottom: 3px solid var(--pnp-gold);
        }

        html,
        body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .main-scroll-area {
            position: absolute;
            top: calc(var(--service-h) + var(--header-h));
            left: 0;
            right: 0;
            bottom: 0;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
            overscroll-behavior: contain;
            background-color: #f8faf9;
        }

            .main-scroll-area::-webkit-scrollbar {
                width: 10px;
            }

            .main-scroll-area::-webkit-scrollbar-thumb {
                background-color: rgba(0, 0, 0, .25);
                border-radius: 4px;
            }

        /* ============================================================
                                               Imagen institucional
                               ============================================================ */
        .pnp-fondo {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .pnp-fondo-img {
            max-width: 740px;
            height: auto;
            opacity: 0.9;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, .1);
            transition: transform .3s ease, opacity .3s ease;
        }

            .pnp-fondo-img:hover {
                transform: scale(1.03);
                opacity: 1;
            }

        /* ============================================================
                              BASE Y RESPONSIVE – Sección: Criterio / Valor / Huella
                               ============================================================ */

        /* Tamaño base (pantallas grandes) */
        .form-line .form-label {
            font-size: .90rem;
        }

        .form-line .input-group-text {
            font-size: .90rem;
            padding: .35rem .55rem;
        }

        .form-line .form-control,
        .form-line .form-select {
            font-size: .92rem;
            padding: .45rem .65rem;
        }

        /* Quitar márgenes negativos de la row dentro del card
                               y ajustar padding para que nada se salga a los lados */
        .search-card .card-body .form-line {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

            .search-card .card-body .form-line > .col-12 {
                padding-left: .25rem !important;
                padding-right: .25rem !important;
            }

        /* ====================== */
        /*  TABLET 992px → 768px  */
        /* ====================== */
        @@media (max-width: 991.98px) {
            : root

        {
            --content-w: 100%;
        }

        .app-wrap {
            padding-top: .75rem;
            padding-bottom: 1rem;
        }

        .search-card {
            margin-inline: .4rem;
        }

            .search-card .card-body {
                padding-left: .55rem;
                padding-right: .55rem;
                padding-top: .65rem;
                padding-bottom: .65rem;
            }

        .form-line {
            row-gap: .45rem;
        }

            .form-line .form-label {
                font-size: .82rem;
                margin-bottom: .15rem;
            }

            .form-line .input-group-text {
                font-size: .82rem;
                padding: .28rem .45rem;
            }

            .form-line .form-control,
            .form-line .form-select {
                font-size: .84rem;
                padding: .35rem .50rem;
            }

            /* Evita que icono + input se rompan */
            .form-line .input-group {
                flex-wrap: nowrap !important;
            }

            /* Cada bloque ocupa 100% (se apilan) */
            .form-line > .col-12 {
                flex: 0 0 100%;
                max-width: 100%;
            }

        .footer-note {
            font-size: .78rem;
        }

        }

        /* ====================== */
        /*  MOBILE 768px → 480px  */
        /* ====================== */
        @@media (max-width: 768px) {
            .form-line

        {
            row-gap: .45rem;
        }

        .form-line .form-label {
            font-size: .78rem;
        }

        .form-line .input-group-text {
            font-size: .78rem;
            padding: .22rem .35rem;
        }

        .form-line .form-control,
        .form-line .form-select {
            font-size: .80rem;
            padding: .28rem .40rem;
        }

        }

        @@media (max-width: 480px) {
            .form-line .form-label

        {
            font-size: .74rem;
        }

        .form-line .input-group-text {
            font-size: .74rem;
            padding: .18rem .30rem;
        }

        .form-line .form-control,
        .form-line .form-select {
            font-size: .78rem;
            padding: .24rem .35rem;
        }

        }
    </style>

</head>
<body>
    <!-- Barra superior fija -->
    <div class="service-bar"></div>

    <!-- Encabezado fijo -->
    <nav class="navbar navbar-dark sticky-top">
        <div class="container py-0">
            <div class="d-flex align-items-center gap-2">
                <img src="~/Imagenes/Escudo.png" alt="PNP"
                     style="width:36px;height:auto;margin-left:-40px;"
                     class="rounded-2 border">
                <div class="brand">
                    <small>POLICÍA NACIONAL DEL PERÚ</small>
                    <div class="d-flex align-items-center gap-2">
                        <span>SISTEMA DE CONTROL DE ASISTENCIA</span>
                        <span class="badge rounded-pill text-bg-dark border border-warning-subtle"></span>
                    </div>
                </div>
            </div>
            <a href="javascript:void(0)" id="btnAbrirLogin" class="menu-link">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Iniciar sesión
            </a>
        </div>
    </nav>

    <!-- 🔹 Área desplazable: todo lo que va debajo del header -->
    <div class="main-scroll-area">
        <main class="container app-wrap">
            <div class="card search-card rounded-4">
                <div class="card-body">
                    <form id="buscadorForm" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 align-items-end form-line">
                            <div class="col-12">
                                <label class="form-label">Criterio</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-shield-halved"></i></span>
                                    <select id="criterio" class="form-select" required>
                                        <option value="cip" selected>Por CIP</option>
                                        <option value="huella">Por Huella</option>
                                    </select>
                                </div>
                                <div class="muted-hint">Elige el método de búsqueda.</div>
                            </div>

                            <div class="col-12" id="valorWrap">
                                <label class="form-label">Valor</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-id-badge"></i></span>
                                    <input id="valor" type="text" class="form-control" placeholder="CIP (8 dígitos)" inputmode="numeric" maxlength="8" />
                                </div>
                                <div class="muted-hint">Ingresa el número CIP .</div>
                            </div>


                            <div class="col-12 d-none" id="huellaWrap">
                                <label class="form-label">Huella digital</label>
                                <div class="d-flex gap-2 flex-wrap align-items-center">
                                    <button type="button" id="btnCapturarHuella" class="btn btn-outline-secondary">
                                        <i class="fa-solid fa-fingerprint"></i> Capturar huella
                                    </button>
