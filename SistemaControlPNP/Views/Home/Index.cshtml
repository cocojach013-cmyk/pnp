          function onActivity(e){ if(e.type==='mousemove'||e.type==='pointermove'){ const now=Date.now(); if(now-lastMove<200) return; lastMove=now; } programarReset(); }
          ['mousemove','pointermove','mousedown','keydown','wheel','touchstart','touchmove','click'].forEach(ev=>document.addEventListener(ev,onActivity,{passive:true}));
