          const movIdSel=document.getElementById('Mov_IdPersonal');
          const movDisplay=document.getElementById('Mov_PersonalDisplay');
          const movAutorizaSel=document.getElementById('Mov_AutorizaSelect');
          const movAutorizaGrp=document.getElementById('Mov_AutorizaOtrosGroup');
          const movAutoriza=document.getElementById('Mov_Autoriza');
          const movDestinoSel=document.getElementById('Mov_DestinoSelect');
          const movDestinoGrp=document.getElementById('Mov_DestinoOtrosGroup');
          const movDestino=document.getElementById('Mov_Destino');
          const movMotivoSel=document.getElementById('Mov_MotivoSelect');
          const movMotivoGrp=document.getElementById('Mov_MotivoOtrosGroup');
          const movMotivo=document.getElementById('Mov_Motivo');
          const movErrIdPer=document.getElementById('err_Mov_IdPersonal');
          const movErrAut=document.getElementById('err_Mov_Autoriza');
          const movErrDes=document.getElementById('err_Mov_Destino');
          const movErrMot=document.getElementById('err_Mov_Motivo');
          const movSave=document.getElementById('Mov_Save');
          const movCancel=document.getElementById('Mov_Cancel');

          function prepareMovPerson(person){
            if(!person) return;
            movIdSel.innerHTML=''; const opt=document.createElement('option');
            opt.value=String(person.id||''); const label=`${person.grado?person.grado+' ':''}${(person.nombres||'')+' '+(person.apellidos||'')}`.trim()||'Seleccionar...';
            opt.textContent=label; movIdSel.appendChild(opt); movIdSel.value=String(person.id||''); movDisplay.value=label;
          }
          function setFieldError(inputEl,msg,errEl){ if(inputEl){ inputEl.classList.add('is-invalid'); } if(errEl){ errEl.textContent=msg||''; } }
          function clearFieldError(inputEl,errEl){ if(inputEl){ inputEl.classList.remove('is-invalid'); } if(errEl){ errEl.textContent=''; } }

          function syncMovAutoriza(){
            const v=movAutorizaSel.value; clearFieldError(movAutorizaSel,movErrAut);
            if(v==='OTROS'){ movAutorizaGrp.classList.remove('d-none'); movAutoriza.removeAttribute('readonly'); movAutoriza.value=''; movAutoriza.setAttribute('required','required'); movAutoriza.focus(); }
            else if(v==='ORDEN SUPERIOR'){ movAutorizaGrp.classList.add('d-none'); movAutoriza.value='ORDEN SUPERIOR'; movAutoriza.setAttribute('readonly','readonly'); movAutoriza.removeAttribute('required'); }
            else{ movAutorizaGrp.classList.add('d-none'); movAutoriza.value=''; movAutoriza.removeAttribute('required'); movAutoriza.removeAttribute('readonly'); }
          }
          function syncMovDestino(){
            const opt=movDestinoSel.value; clearFieldError(movDestinoSel,movErrDes);
            if(opt==='OTROS'){ movDestinoGrp.classList.remove('d-none'); movDestino.removeAttribute('readonly'); movDestino.value=''; movDestino.focus(); }
            else if(opt){ movDestinoGrp.classList.add('d-none'); movDestino.value=opt; movDestino.setAttribute('readonly','readonly'); }
            else{ movDestinoGrp.classList.add('d-none'); movDestino.value=''; movDestino.removeAttribute('readonly'); }
          }
          function syncMovMotivo(){
            const v=(movMotivoSel.value || '').toUpperCase(); clearFieldError(movMotivoSel,movErrMot);
            if(v==='OTRAS'){
              movMotivoGrp.classList.remove('d-none'); movMotivo.removeAttribute('readonly'); movMotivo.value=''; movMotivo.setAttribute('required','required'); movMotivo.focus();
            } else if(v){
              movMotivoGrp.classList.add('d-none'); movMotivo.value=movMotivoSel.value; movMotivo.setAttribute('readonly','readonly'); movMotivo.removeAttribute('required');
            } else {
              movMotivoGrp.classList.add('d-none'); movMotivo.value=''; movMotivo.removeAttribute('readonly'); movMotivo.removeAttribute('required');
            }
          }
          if(movAutorizaSel) movAutorizaSel.addEventListener('change',syncMovAutoriza);
          if(movDestinoSel) movDestinoSel.addEventListener('change',syncMovDestino);
          if(movMotivoSel)  movMotivoSel.addEventListener('change',syncMovMotivo);
          ['input','change'].forEach(evt=>{
            if(movAutoriza) movAutoriza.addEventListener(evt,()=>clearFieldError(movAutorizaSel,movErrAut));
            if(movDestino)  movDestino.addEventListener(evt,()=>clearFieldError(movDestinoSel,movErrDes));
            if(movMotivo)   movMotivo.addEventListener(evt,()=>clearFieldError(movMotivoSel,movErrMot));
          });
          if(btnOpenMovModal && movModal){
            btnOpenMovModal.addEventListener('click', ()=>{
              syncMovAutoriza(); syncMovDestino(); syncMovMotivo();
              [movAutorizaSel,movDestinoSel,movMotivoSel].forEach(el=>el && el.classList.remove('is-invalid'));
              [movErrAut,movErrDes,movErrMot].forEach(el=>el && (el.textContent=''));
              movModal.show(); setTimeout(()=>{ (movMotivoSel && !movMotivoSel.value) ? movMotivoSel.focus() : null; },150);
            });
          }
          if(movCancel && movModal){ movCancel.addEventListener('click',()=>movModal.hide()); }

          if(movSave){
            movSave.addEventListener('click', async function(){
              let valid=true;
              const idSel=Number(movIdSel.value||0); if(!idSel){ valid=false; setFieldError(movIdSel,'Seleccione personal.',movErrIdPer); }
              let motivoVal=(movMotivo?.value||'').trim(); if(!motivoVal){ valid=false; setFieldError(movMotivoSel,'Complete el motivo del movimiento.',movErrMot); }
              const autorizaVal=(document.getElementById('Mov_Autoriza')?.value||'').trim(); if(!autorizaVal){ valid=false; setFieldError(movAutorizaSel,'Indique quién autoriza.',movErrAut); }
              const destinoVal=(document.getElementById('Mov_Destino')?.value||'').trim();
              if(!document.getElementById('Mov_DestinoOtrosGroup').classList.contains('d-none') && !destinoVal){ valid=false; setFieldError(movDestinoSel,'Especifique destino.',movErrDes); }
              if(!valid) return;

              const token=(document.querySelector('input[name="__RequestVerificationToken"]')||{}).value||'';
              const btn=this; btn.disabled=true;
              try{
                const r=await fetch('@Url.Action("RegistrarMovimiento", "Control")',{ method:'POST', headers:{'Content-Type':'application/json','RequestVerificationToken':token}, body:JSON.stringify({ idPersonal:idSel, motivo:motivoVal, autoriza:autorizaVal, destino:destinoVal }) });
                if(!r.ok) throw new Error('HTTP '+r.status);
                const j=await r.json();
                if(j.success){ showStatusModal({ title:'', html:'Movimiento registrado', type:'success', autoCloseMs:1200 }); movModal.hide(); await autoBuscar(); }
                else{ showStatusModal({ title:'Aviso', html:(j.message||'No se pudo registrar el movimiento.'), type:'info', autoCloseMs:1800 }); }
              }catch(e){ showStatusModal({ title:'Error', html:'Error al registrar el movimiento.', type:'danger', autoCloseMs:2200 }); }
              finally{ btn.disabled=false; }
            });
          }

          // ===== Retorno =====
          const retModalEl=document.getElementById('retModal');
          const retModal=retModalEl?new bootstrap.Modal(retModalEl):null;
          const retIdSel=document.getElementById('Ret_IdPersonal');
          const retDisplay=document.getElementById('Ret_PersonalDisplay');
          const retNoved=document.getElementById('Ret_Novedades');
          const retErrId=document.getElementById('err_Ret_IdPersonal');
          const retErrNov=document.getElementById('err_Ret_Novedades');
          const retSave=document.getElementById('Ret_Save');

          if(btnRegistrarRetorno && retModal){
            btnRegistrarRetorno.addEventListener('click', ()=>{
              const id=Number((document.getElementById('resultCard')?.dataset?.id)||0);
              if(!id){ setMsg('ID de personal no válido.','danger',2200); return; }
              const grado=(resGrado?.textContent||'').trim(); const nombre=(resNombre?.textContent||'').trim();
              const label=`${grado?grado+' ':''}${nombre}`.trim()||'—';
              retIdSel.innerHTML=''; const opt=document.createElement('option'); opt.value=String(id); opt.textContent=label; retIdSel.appendChild(opt); retIdSel.value=String(id);
              retDisplay.value=label; retNoved.value='';
              [retIdSel].forEach(el=>el && el.classList.remove('is-invalid'));
              [retErrId,retErrNov].forEach(el=>el && (el.textContent=''));
              retModal.show(); setTimeout(()=>{ retNoved && retNoved.focus(); },150);
            });
          }

          if(retSave){
            retSave.addEventListener('click', async function(){
              let valid=true; const idSel=Number(retIdSel.value||0);
              if(!idSel){ valid=false; if(retErrId) retErrId.textContent='Personal no válido.'; }
              if(!valid) return;

              const novedades=(retNoved.value||'').trim();
              const token=(document.querySelector('input[name="__RequestVerificationToken"]')||{}).value||'';
              const btn=this; btn.disabled=true;
              try{
                const r=await fetch('@Url.Action("RegistrarRetornoMovimiento", "Control")',{ method:'POST', headers:{'Content-Type':'application/json','RequestVerificationToken':token}, body:JSON.stringify({ idPersonal:idSel, novedades }) });
                if(!r.ok) throw new Error('HTTP '+r.status);
                const j=await r.json();
                if(j.success){ showStatusModal({ title:'', html:'Retorno registrado', type:'success', autoCloseMs:1200 }); retModal.hide(); await autoBuscar(); }
                else{ showStatusModal({ title:'Aviso', html:(j.message||'No se pudo registrar el retorno.'), type:'info', autoCloseMs:1800 }); }
              }catch(e){ showStatusModal({ title:'Error', html:'Error al registrar el retorno.', type:'danger', autoCloseMs:2200 }); }
              finally{ btn.disabled=false; }
            });
          }

          // Login
          const loginModalEl2=document.getElementById('loginModal');
          if(loginModalEl2){
            const loginModal=new bootstrap.Modal(loginModalEl2);
            const loginFrame=document.getElementById('loginFrame');
            const btnLogin=document.getElementById('btnAbrirLogin');
            if(btnLogin){ btnLogin.addEventListener('click', ()=>{ loginFrame.src='@Url.Action("Login", "Acceso")'; loginModal.show(); }); }
            loginModalEl2.addEventListener('hidden.bs.modal',()=>{ loginFrame.src='about:blank'; });
          }

          // === Forzar mayúsculas durante escritura
          function attachUppercaseBehavior(el){
            if(!el) return;
            el.addEventListener('input', ()=>{
              const selStart = el.selectionStart, selEnd = el.selectionEnd;
              const upper = (el.value || '').toUpperCase();
              if(el.value !== upper){
                el.value = upper;
                try { el.setSelectionRange(selStart, selEnd); } catch {}
              }
            });
          }
          ['Mov_Autoriza','Mov_Destino','Mov_Motivo','Ret_Novedades'].forEach(id=>{
            attachUppercaseBehavior(document.getElementById(id));
          });

          // init
          resetUI();
        })();
    </script>
</body>
</html>
