          // Buscar
          async function ejecutarBusqueda(){
            const crit=criterio ? criterio.value : 'cip';
            if(crit==='cip'){ const v=(valor && valor.value || '').trim(); if(v.length!==8){ setMsg('El CIP debe tener 8 dígitos.','warning'); hideResult(); return; } }
            else if(crit==='huella'){ if(!huellaBase64 || !huellaBase64.value){ setMsg('Primero captura la huella.','warning'); hideResult(); return; } }

            setMsg('<i class="fa-solid fa-magnifying-glass me-1"></i> Buscando…','info',0);
            const token=(document.querySelector('input[name="__RequestVerificationToken"]')||{}).value||'';
            const payload={ criterio:crit, valor:(crit==='huella')?'':((valor && valor.value)||'').trim(), huellaBase64:(crit==='huella')?(huellaBase64 && huellaBase64.value || ''):null };

            try{
              const resp=await fetch('@Url.Action("BuscarPersona", "Control")',{ method:'POST', headers:{'Content-Type':'application/json','RequestVerificationToken':token}, body:JSON.stringify(payload) });
              if(!resp.ok) throw new Error('HTTP '+resp.status);
              const json=await resp.json();
              if(!json.success){
                // Mensaje y limpieza del CIP "juntos"
                setMsg(json.message||'No se encontró personal.','warning',2500);
                hideResult();
                if(criterio && criterio.value==='cip' && valor){ valor.value=''; valor.focus(); }
                return;
              }

              const d=json.data||{};

              // ✅ Foto SIEMPRE con fallback a sin-perfil.jpg
              var foto = (d.foto || '').trim();
              resFoto.src = foto ? foto : '@placeholder';
              resFoto.onerror = function () {
                  this.onerror = null;
                  this.src = '@placeholder';
              };

              resGrado.textContent=d.grado||'—';
              resNombre.textContent=((d.nombres||'')+' '+(d.apellidos||'')).trim()||'—';
              resUnidad.textContent=d.unidad||'—';

              result.dataset.id=d.id;
              result.classList.remove('d-none');
              accionesTop.classList.add('show');

              // Render
              renderMovPend(json.movimientosPendientes||[]);
              renderOpenAsis(json.asistenciasAbiertas||[]);
              renderCyclesTable(json.ciclos||[]);
              renderMovToday(json.movimientosHoy || []);

              // === Reglas de visibilidad por conteos ===
              const hoy = Array.isArray(json.ciclos) ? json.ciclos.length : 0;
              const movC = Array.isArray(json.movimientosHoy) ? json.movimientosHoy.length : 0;

              // Mostrar/ocultar línea y tabla de asistencias de hoy
              if(hoy > 0){
                hoyCount.textContent=String(hoy);
                hoyCountLine.classList.remove('d-none');
                cyclesWrap.classList.add('d-none'); // inicia plegado
                if(toggleHint) toggleHint.textContent='(clic para ver)';
              }else{
                hoyCountLine.classList.add('d-none');
                cyclesWrap.classList.add('d-none');
              }

              // Movimientos del día SOLO si existe asistencia abierta hoy y hay registros
              const asistenciaAbiertaHoy = !!json.asistenciaAbiertaHoy;
              const mostrarMovimientosHoy = asistenciaAbiertaHoy && (movC > 0);
              if(mostrarMovimientosHoy){
                movTodayCount.textContent=String(movC);
                movTodayCountLine.classList.remove('d-none');
                movTodayWrap.classList.add('d-none'); // plegado
                if(toggleMovTodayHint) toggleMovTodayHint.textContent='(clic para ver)';
              }else{
                movTodayCountLine.classList.add('d-none');
                movTodayWrap.classList.add('d-none');
              }

              // Permisos/acciones
              const ya=json.yaTieneAlgunaHoy,
                    pIn=json.puedeRegistrarIngreso,
                    pOut=json.puedeRegistrarSalida,
                    pMov=json.puedeRegistrarMovimiento,
                    pRet=json.puedeRegistrarRetornoMovimiento;

              btnReg.classList.add('d-none');
              okHoy.classList.add('d-none');
              accionesPostEntrada.classList.add('d-none');
              btnRegistrarRetorno.classList.add('d-none');
