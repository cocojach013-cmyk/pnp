            function updateMovTodayElapsed(){
              const now = Date.now();
              document.querySelectorAll('#movTodayTbody .movtoday-elapsed').forEach(span=>{
                const sIso = span.getAttribute('data-salida-utc')  || '';
                const rIso = span.getAttribute('data-retorno-utc') || '';
                const ts = Date.parse(sIso);
                const tr = rIso ? Date.parse(rIso) : NaN;
                if(isNaN(ts)){ span.textContent = '--:--:--'; return; }
                const endMs = !isNaN(tr) ? tr : now;
                span.textContent = fmtElapsed(endMs - ts);
