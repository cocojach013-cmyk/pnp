          // === Llegada: cálculo robusto ===
          function _numOrNull(v){ const n = Number(v); return Number.isFinite(n) ? n : null; }
          function _getLateInfo(row){
            const onTime     = (typeof row.onTime === 'boolean') ? row.onTime : null;
            const llegoTarde = (typeof row.llegoTarde === 'boolean') ? row.llegoTarde : null;

            const sA = _numOrNull(row.lateSeconds);
            const sB = _numOrNull(row.segundosTarde);
            const mA = _numOrNull(row.minutesLate);
            const mB = _numOrNull(row.minutosTarde);

            let lateSeconds = null;
            if(sA != null) lateSeconds = sA;
            else if(sB != null) lateSeconds = sB;
            else if(mA != null) lateSeconds = mA * 60;
            else if(mB != null) lateSeconds = mB * 60;

            let isLate = false;
            if(onTime === false) isLate = true;
            else if(llegoTarde === true) isLate = true;
            else if(lateSeconds != null && lateSeconds > 0) isLate = true;

            return { isLate, lateSeconds: lateSeconds || 0 };
          }
          function _fmtHMSFromSeconds(totalSeconds){
            if (isNaN(totalSeconds) || totalSeconds < 0) totalSeconds = 0;
            const h = Math.floor(totalSeconds/3600);
            const m = Math.floor((totalSeconds%3600)/60);
            const s = Math.floor(totalSeconds%60);
            return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
          }
          function llegadaBadge(row){
            const { isLate, lateSeconds } = _getLateInfo(row);
            if (isLate){
              return `<span class="badge text-bg-danger" title="CORTE 07:45">TARDE (${_fmtHMSFromSeconds(lateSeconds)})</span>`;
            }
            return `<span class="badge text-bg-success" title="CORTE 07:45">A TIEMPO</span>`;
          }

