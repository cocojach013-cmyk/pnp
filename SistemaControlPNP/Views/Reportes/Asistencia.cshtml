@{
    ViewData["Title"] = "Reporte de Asistencias";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/Style/reporte-styles.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="mov-page container-fluid py-3">
    <!-- Header -->
    <div class="mb-3 gap-2 flex-wrap page-head no-print">
        <h5 class="m-0">
            <i class="fa-solid fa-user-clock me-2"></i>Reporte de Asistencias
        </h5>
        <div class="actions-toolbar">
            <button id="btnClearAll" class="btn btn-success">
                <i class="fa-solid fa-eraser me-1"></i> Limpiar
            </button>
            <a id="btnExport" class="btn btn-outline-secondary" href="#">
                <i class="fa-solid fa-file-csv me-1"></i> Exportar
            </a>
            <button id="btnPrint" class="btn btn-outline-primary">
                <i class="fa-solid fa-print me-1"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- === FILTROS === -->
    <div class="card-like mb-3 no-print">
        <div class="p-3 filters-2rows">
            <div class="filters-grid">

                <div class="col">
                    <label class="form-label">Buscar</label>
                    <input id="q" type="text" class="form-control" placeholder="Nombre, apellido, CIP…">
                </div>

                <div class="col">
                    <label class="form-label">Desde</label>
                    <input id="desde" type="date" class="form-control">
                </div>

                <div class="col">
                    <label class="form-label">Hasta</label>
                    <input id="hasta" type="date" class="form-control">
                </div>

                <div class="col">
                    <label class="form-label">&nbsp;</label>
                    <button id="btnClearDates" class="btn btn-light w-100">
                        <i class="fa-solid fa-rotate-left"></i> Limpiar fechas
                    </button>
                </div>

                <div class="col">
                    <label class="form-label">Sexo</label>
                    <select id="sexo" class="form-select">
                        <option value="">Todos</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                </div>

                <!-- === GRADO === -->
                <div class="col">
                    <label class="form-label">Grado</label>
                    <div class="mdrop" id="mdGrado">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todos</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>

                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

                <!-- === UNIDAD === -->
                <div class="col">
                    <label class="form-label">Unidad</label>
                    <div class="mdrop" id="mdUnidad">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todas</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>

                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <label class="form-label">Edad ≥</label>
                    <input id="edadMin" type="number" class="form-control">
                </div>

                <div class="col">
                    <label class="form-label">Edad ≤</label>
                    <input id="edadMax" type="number" class="form-control">
                </div>

                <div class="col">
                    <label class="form-label">Estado</label>
                    <select id="estadoSel" class="form-select">
                        <option value="">Todos</option>
                        <option value="Tarde">Tarde</option>
                        <option value="Temprano">Temprano</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- === KPIs (como en movimientos, sobre la tabla) === -->
    <div class="row g-3 mb-2 no-print">
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Total registros</div>
                <div class="fs-5 fw-bold" id="kTot">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Tardanzas</div>
                <div class="fs-5 fw-bold text-danger" id="kTarde">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Tempranos</div>
                <div class="fs-5 fw-bold text-primary" id="kTemp">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">% Tardanzas</div>
                <div class="fs-5 fw-bold" id="kPctTarde">0%</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Prom. retraso</div>
                <div class="fs-5 fw-bold" id="kAvgRet">00:00:00</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Máx. retraso</div>
                <div class="fs-5 fw-bold" id="kMaxRet">00:00:00</div>
            </div>
        </div>
    </div>

    <!-- === TABS LISTA / RESUMEN === -->
    <ul class="nav nav-tabs no-print mb-2" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-lista" type="button" role="tab">
                <i class="fa-solid fa-list me-1"></i> Lista
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-resumen" type="button" role="tab">
                <i class="fa-solid fa-table me-1"></i> Resumen por persona
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- === TAB LISTA === -->
        <div id="tab-lista" class="tab-pane fade show active" role="tabpanel">
            <div class="print-scope">
                <!-- Título solo para impresión -->
                <div class="print-title d-none d-print-block">
                    <i class="fa-solid fa-user-clock me-2"></i>Reporte de Asistencias
                </div>

                <div class="table-wrap sticky-head mb-3">
                    <table class="table table-sm table-hover align-middle table-striped table-compact" id="tbl">
                        <colgroup>
                            <col style="width:120px">
                            <col style="width:90px">
                            <col style="width:120px">
                            <col style="width:90px">
                            <col style="width:86px">
                            <col style="width:86px">
                            <col style="width:90px">
                        </colgroup>

                        <thead class="table-dark">
                            <tr>
                                <th>Fecha Ingreso</th>
                                <th>Hora Ingreso</th>
                                <th>Fecha Salida</th>
                                <th>Hora Salida</th>
                                <th>Estado</th>
                                <th class="text-end">Retraso</th>
                                <th>CIP</th>
                                <th class="col-grado">Grado</th>
                                <th>Apellidos</th>
                                <th>Nombres</th>
                                <th class="col-sexo">Sexo</th>
                                <th class="text-end col-edad">Edad</th>
                                <th class="col-unidad">Unidad</th>
                                <th class="col-control">Control</th>
                            </tr>
                        </thead>

                        <tbody id="tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- === TAB RESUMEN === -->
        <div id="tab-resumen" class="tab-pane fade" role="tabpanel">
            <div class="table-wrap sticky-head">
                <table class="table table-sm table-hover align-middle table-striped table-compact" id="tblResumen">
                    <thead class="table-dark">
                        <tr>
                            <th>CIP</th>
                            <th>Apellidos y Nombres</th>
                            <th class="col-unidad">Unidad</th>
                            <th class="col-sexo">Sexo</th>
                            <th class="text-end col-edad">Edad</th>
                            <th class="text-end">Total Registros</th>
                            <th class="text-end">Tardanzas</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyResumen"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {

            const fetchUrl='@Url.Action("Json", "ReporteAsistencia")';
            const exportUrl='@Url.Action("ExportCsv", "ReporteAsistencia")';

            const $q=g('q'), $desde=g('desde'), $hasta=g('hasta'),
                  $sexo=g('sexo'), $edadMin=g('edadMin'), $edadMax=g('edadMax'), $estadoSel=g('estadoSel'),
                  $btnClearDates=g('btnClearDates'), $btnClearAll=g('btnClearAll'),
                  $btnExport=g('btnExport'), $btnPrint=g('btnPrint');

            // KPIs
            const $kTot     = g('kTot');
            const $kTarde   = g('kTarde');
            const $kTemp    = g('kTemp');
            const $kPctTarde= g('kPctTarde');
            const $kAvgRet  = g('kAvgRet');
            const $kMaxRet  = g('kMaxRet');

            const mdGrado  = mdrop('#mdGrado');
            const mdUnidad = mdrop('#mdUnidad');

            const $tbody=g('tbody'), $tbodyResumen=g('tbodyResumen');

            let raw=[], view=[];

            function g(id){return document.getElementById(id)}

            function esc(s){return (s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}

            const deb=(fn,ms)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms);};};

            /* === Multiselect === */
            function mdrop(sel){
                const root=typeof sel==='string'?document.querySelector(sel):sel;
                const toggle=root.querySelector('.mdrop-toggle');
                const search=root.querySelector('.mdrop-head input[type="text"]');
                const btnAll=root.querySelector('[data-act="all"]'),
                      btnNone=root.querySelector('[data-act="none"]');
                const list=root.querySelector('.mdrop-list'),
                      label=root.querySelector('.mdrop-label');

                let values=[], chosen=new Set();

                toggle.addEventListener('click',(e)=>{
                    e.stopPropagation();
                    closeAllDrops(root);
                    root.classList.toggle('open');
                    search?.focus();
                });

                document.addEventListener('click',(e)=>{
                    if(!root.contains(e.target)) root.classList.remove('open');
                });

                btnAll.addEventListener('click',()=>{
                    values.forEach(v=>chosen.add(v));
                    draw(); setLabel(); changed();
                });

                btnNone.addEventListener('click',()=>{
                    chosen.clear(); draw(); setLabel(); changed();
                });

                search?.addEventListener('input',()=> draw(search.value.trim().toLowerCase()));

                function draw(filter=""){
                    list.innerHTML = values
                        .filter(v=>!filter || v.toLowerCase().includes(filter))
                        .map(v=>`<label class="mdrop-item">
                            <input type="checkbox" value="${esc(v)}" ${chosen.has(v)?'checked':''}/>
                            <span class="wrap-2">${esc(v)}</span>
                        </label>`).join('');

                    list.querySelectorAll('input[type="checkbox"]').forEach(chk=>{
                        chk.addEventListener('change',()=>{
                            const v=chk.value;
                            if(chk.checked) chosen.add(v); else chosen.delete(v);
                            if(search && search.value) search.value="";
                            setLabel(); draw(); changed();
                        });
                    });
                }

                function setLabel(){
                    if(chosen.size===0) label.textContent = (root.id==='mdUnidad'?'Todas':'Todos');
                    else if(chosen.size===1) label.textContent=[...chosen][0];
                    else label.textContent=`${chosen.size} seleccionados`;
                }

                function setOptions(arr){
                    values = Array.from(new Set(arr.filter(Boolean).map(v=>v.trim()))).sort((a,b)=>a.localeCompare(b));
                    chosen = new Set([...chosen].filter(v=>values.includes(v)));
                    draw(); setLabel();
                }

                function getSelected(){ return [...chosen]; }
                function clear(){ chosen.clear(); setLabel(); draw(); changed(); }
                function changed(){ root.dispatchEvent(new CustomEvent('mdrop:change')); }

                return { setOptions, getSelected, clear, root };
            }

            function closeAllDrops(except){
                document.querySelectorAll('.mdrop.open').forEach(el=>{
                    if(except && el===except) return;
                    el.classList.remove('open');
                });
            }

            function buildQuery(){
                const p=new URLSearchParams();
                if($desde.value) p.set('desde',$desde.value);
                if($hasta.value) p.set('hasta',$hasta.value);
                if($sexo.value)  p.set('sexo',$sexo.value);
                if($edadMin.value) p.set('edadMin',$edadMin.value);
                if($edadMax.value) p.set('edadMax',$edadMax.value);
                mdGrado.getSelected().forEach(v=>p.append('grado',v));
                mdUnidad.getSelected().forEach(v=>p.append('unidad',v));
                if($estadoSel.value) p.set('estado',$estadoSel.value);
                return p.toString();
            }

            async function load(){
                try{
                    const qs=buildQuery();
                    const url=qs? `${fetchUrl}?${qs}`: fetchUrl;

                    const res=await fetch(url,{headers:{'Accept':'application/json'}});
                    if(!res.ok) throw new Error(`HTTP ${res.status}`);

                    raw=await res.json();
                    if(!Array.isArray(raw)) raw=[];

                    mdGrado.setOptions(raw.map(r=>r.grado||''));
                    mdUnidad.setOptions(raw.map(r=>r.unidad||''));

                    apply();
                    updateExport();

                }catch(e){ console.error('Error:', e); }
            }

            function minsToHHMMSS(mins){
                const m=Math.max(0,parseInt(mins||0,10));
                const h=Math.floor(m/60), mm=m%60;
                return `${String(h).padStart(2,'0')}:${String(mm).padStart(2,'0')}:00`;
            }

            function apply(){
                const text=($q.value||"").trim().toLowerCase();
                const sex=$sexo.value, est=$estadoSel.value;
                const gradosSel=mdGrado.getSelected();
                const unidadesSel=mdUnidad.getSelected();
                const emin=parseInt($edadMin.value||'0',10),
                      emax=parseInt($edadMax.value||'200',10);

                view = raw.filter(r=>{
                    if(sex && (r.sexo||"").toUpperCase()!==sex) return false;
                    if(est && (r.estadoLlegada||"")!==est) return false;

                    if(gradosSel.length>0){
                        const g=(r.grado||"").trim();
                        if(!gradosSel.includes(g)) return false;
                    }
                    if(unidadesSel.length>0){
                        const u=(r.unidad||"").trim();
                        if(!unidadesSel.includes(u)) return false;
                    }

                    const ed = r.edad!=null ? parseInt(r.edad,10) : null;
                    if(ed!=null && (ed<emin || ed>emax)) return false;

                    if(text){
                        const bucket=[
                            r.cip,r.grado,r.apellidos,r.nombres,r.unidad,
                            r.fecha,r.horaIngreso,r.fechaSalida,r.horaSalida,
                            r.estadoLlegada,r.control
                        ].map(x=>(x||"").toString().toLowerCase()).join(" ");

                        if(!bucket.includes(text)) return false;
                    }

                    return true;
                });

                renderTable();
                renderResumen();
                renderKpis();
            }

            function renderTable(){
                $tbody.innerHTML = view.map(r=>{
                    let cls='bg-success';
                    if(r.estadoLlegada==='Tarde') cls='bg-danger';
                    if(r.estadoLlegada==='Temprano') cls='bg-primary';

                    return `
                    <tr>
                        <td>${r.fecha||''}</td>
                        <td>${r.horaIngreso||''}</td>
                        <td>${r.fechaSalida||''}</td>
                        <td>${r.horaSalida||''}</td>
                        <td><span class="badge ${cls}">${r.estadoLlegada||''}</span></td>
                        <td class="text-end">${minsToHHMMSS(r.retrasoMin)}</td>
                        <td>${r.cip||''}</td>
                        <td class="col-grado">${r.grado||''}</td>
                        <td>${r.apellidos||''}</td>
                        <td>${r.nombres||''}</td>
                        <td class="col-sexo">${r.sexo||''}</td>
                        <td class="text-end col-edad">${r.edad||''}</td>
                        <td class="col-unidad">${r.unidad||''}</td>
                        <td class="col-control">${r.control||''}</td>
                    </tr>`;
                }).join('');
            }

            function renderKpis(){
                const total = view.length;
                const tardes = view.filter(r=>r.estadoLlegada==='Tarde').length;
                const temps  = view.filter(r=>r.estadoLlegada==='Temprano').length;

                const retrasos = view
                    .map(r=>parseInt(r.retrasoMin||0,10))
                    .filter(n=>!isNaN(n) && n>=0);

                const avg = retrasos.length
                    ? Math.round(retrasos.reduce((a,b)=>a+b,0)/retrasos.length)
                    : 0;

                const max = retrasos.length
                    ? Math.max(...retrasos)
                    : 0;

                const pctTarde = total ? Math.round((tardes*100)/total) : 0;

                if($kTot)      $kTot.textContent = total;
                if($kTarde)    $kTarde.textContent = tardes;
                if($kTemp)     $kTemp.textContent = temps;
                if($kPctTarde) $kPctTarde.textContent = `${pctTarde}%`;
                if($kAvgRet)   $kAvgRet.textContent = minsToHHMMSS(avg);
                if($kMaxRet)   $kMaxRet.textContent = minsToHHMMSS(max);
            }

            function renderResumen(){
                const map=new Map();

                for(const r of view){
                    const key=r.cip?.trim() || `${(r.apellidos||'').trim()}|${(r.nombres||'').trim()}` || 'NO-KEY';

                    if(!map.has(key)){
                        map.set(key,{
                            cip:r.cip||'',
                            nombre:`${r.apellidos||''} ${r.nombres||''}`.trim(),
                            unidad:r.unidad||'',
                            sexo:r.sexo||'',
                            edad:r.edad||'',
                            total:0,
                            tardes:0
                        });
                    }

                    const it=map.get(key);
                    it.total++;
                    if(r.estadoLlegada==='Tarde') it.tardes++;
                }

                const arr=[...map.values()].sort((a,b)=> b.tardes-a.tardes || a.nombre.localeCompare(b.nombre));

                $tbodyResumen.innerHTML = arr.map(x=>`
                    <tr>
                        <td>${x.cip}</td>
                        <td>${x.nombre}</td>
                        <td class="col-unidad">${x.unidad}</td>
                        <td class="col-sexo">${x.sexo}</td>
                        <td class="text-end col-edad">${x.edad}</td>
                        <td class="text-end">${x.total}</td>
                        <td class="text-end ${x.tardes>0?'text-danger fw-bold':''}">${x.tardes}</td>
                    </tr>
                `).join('');
            }

            function updateExport(){
                const p=new URLSearchParams();
                if($q.value) p.set('q',$q.value.trim());
                if($desde.value) p.set('desde',$desde.value);
                if($hasta.value) p.set('hasta',$hasta.value);
                if($sexo.value) p.set('sexo',$sexo.value);
                if($edadMin.value) p.set('edadMin',$edadMin.value);
                if($edadMax.value) p.set('edadMax',$edadMax.value);

                mdGrado.getSelected().forEach(v=>p.append('grado',v));
                mdUnidad.getSelected().forEach(v=>p.append('unidad',v));

                if($estadoSel.value) p.set('estado',$estadoSel.value);

                const qs=p.toString();
                $btnExport.href = qs ? `${exportUrl}?${qs}` : exportUrl;
            }

            const debLoad=deb(load,200);
            const debApply=deb(apply,120);

            $q.addEventListener('input', ()=>{ debApply(); updateExport(); });

            [$desde,$hasta].forEach(el=> el.addEventListener('input', debLoad));

            [$sexo,$edadMin,$edadMax,$estadoSel].forEach(el=>{
                el.addEventListener('input', debLoad);
                el.addEventListener('change', debLoad);
            });

            mdGrado.root.addEventListener('mdrop:change', debLoad);
            mdUnidad.root.addEventListener('mdrop:change', debLoad);

            $btnClearDates.addEventListener('click', ()=>{
                $desde.value=""; $hasta.value="";
                debLoad();
            });

            $btnClearAll.addEventListener('click', ()=>{
                $q.value="";
                $desde.value=""; $hasta.value="";
                $sexo.value="";
                $estadoSel.value="";
                $edadMin.value="";
                $edadMax.value="";
                mdGrado.clear();
                mdUnidad.clear();
                debLoad();
            });

            $btnPrint.addEventListener('click', ()=> window.print());

            /* ✅ FIX RESUMEN POR PERSONA (tabs funcionan aunque no cargue Bootstrap JS) */
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn=>{
                btn.addEventListener('shown.bs.tab', ()=>{ try{ renderResumen(); }catch{} });

                btn.addEventListener('click', (e)=>{
                    if (!window.bootstrap || !window.bootstrap.Tab){
                        e.preventDefault();
                        const target = btn.getAttribute('data-bs-target');

                        document.querySelectorAll('.nav-link[data-bs-toggle="tab"]').forEach(x=>x.classList.remove('active'));
                        document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('show','active'));

                        btn.classList.add('active');
                        const pane=document.querySelector(target);
                        if(pane) pane.classList.add('show','active');

                        try{ renderResumen(); }catch{}
                    }
                });
            });

            load();

        })();
    </script>
    <!-- Bootstrap JS obligatorio para tabs, dropdowns, modals, nav-tabs, etc. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
