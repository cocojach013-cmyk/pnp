@{
    ViewData["Title"] = "Reporte de Movimientos";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/Style/reporte-styles.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="mov-page container-fluid py-3">
    <!-- Header -->
    <div class="mb-3 gap-2 flex-wrap page-head no-print">
        <h5 class="m-0">
            <i class="fa-solid fa-person-walking-arrow-right me-2"></i>
            Reporte de Movimientos
        </h5>
        <div class="actions-toolbar">
            <!-- Botón ahora es LIMPIAR TODO -->
            <button id="btnClearAll" class="btn btn-success">
                <i class="fa-solid fa-eraser me-1"></i> Limpiar
            </button>
            <a id="btnExport" class="btn btn-outline-secondary" href="#">
                <i class="fa-solid fa-file-csv me-1"></i> Exportar
            </a>
            <button id="btnPrint" class="btn btn-outline-primary">
                <i class="fa-solid fa-print me-1"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- Filtros en dos bloques responsivos -->
    <div class="card-like mb-3 no-print">
        <div class="p-3 filters-2rows">
            <!-- Bloque 1 -->
            <div class="filters-grid">
                <div class="col">
                    <label class="form-label">Buscar</label>
                    <input id="q" type="text" class="form-control"
                           placeholder="Filtrar por CIP, nombres, unidad, motivo, autoriza, destino…">
                </div>
                <div class="col">
                    <label class="form-label">Desde</label>
                    <input id="desde" type="date" class="form-control">
                </div>
                <div class="col">
                    <label class="form-label">Hasta</label>
                    <input id="hasta" type="date" class="form-control">
                </div>
                <div class="col">
                    <label class="form-label">&nbsp;</label>
                    <button id="btnClearDates" class="btn btn-light w-100">
                        <i class="fa-solid fa-rotate-left"></i> Limpiar fechas
                    </button>
                </div>
                <div class="col">
                    <label class="form-label">Sexo</label>
                    <select id="sexo" class="form-select">
                        <option value="">Todos</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                </div>
                <div class="col">
                    <label class="form-label">Estado</label>
                    <select id="estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Retornado">Retornado</option>
                    </select>
                </div>
            </div>

            <!-- Bloque 2 -->
            <div class="filters-grid">
                <div class="col">
                    <label class="form-label">Duración ≥ (min)</label>
                    <input id="durMin" type="number" class="form-control" min="0" step="1" placeholder="0">
                </div>
                <div class="col">
                    <label class="form-label">Duración ≤ (min)</label>
                    <input id="durMax" type="number" class="form-control" min="0" step="1" placeholder="∞">
                </div>

                <div class="col">
                    <label class="form-label">Unidad</label>
                    <div class="mdrop" id="mdUnidad">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todas</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>
                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <label class="form-label">Autoriza</label>
                    <div class="mdrop" id="mdAutoriza">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todos</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>
                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <label class="form-label">Motivo</label>
                    <div class="mdrop" id="mdMotivo">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todos</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>
                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <label class="form-label">Destino</label>
                    <div class="mdrop" id="mdDestino">
                        <button type="button" class="mdrop-toggle">
                            <span class="mdrop-label">Todos</span>
                            <i class="fa-solid fa-chevron-down ms-2"></i>
                        </button>
                        <div class="mdrop-panel">
                            <div class="mdrop-head">
                                <input type="text" class="form-control form-control-sm" placeholder="Buscar…">
                                <button type="button" class="btn btn-light btn-xs" data-act="all">Todo</button>
                                <button type="button" class="btn btn-light btn-xs" data-act="none">Limpiar</button>
                            </div>
                            <div class="mdrop-list"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-2 no-print">
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Total</div>
                <div class="fs-5 fw-bold" id="kTotal">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Pendientes</div>
                <div class="fs-5 fw-bold text-warning" id="kPend">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Retornados</div>
                <div class="fs-5 fw-bold text-success" id="kRet">0</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">% Retorno</div>
                <div class="fs-5 fw-bold" id="kPct">0%</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Prom. duración</div>
                <div class="fs-5 fw-bold" id="kAvg">00:00</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="kpi p-2 text-center">
                <div class="small">Máx. duración</div>
                <div class="fs-5 fw-bold" id="kMax">00:00</div>
            </div>
        </div>
    </div>

    <!-- Área imprimible -->
    <div class="print-scope">
        <!-- Título para impresión -->
        <div class="print-title d-none d-print-block">
            <i class="fa-solid fa-person-walking-arrow-right me-2"></i>
            Reporte de Movimientos
        </div>

        <div class="table-wrap sticky-head mb-3">
            <table class="table table-sm table-hover align-middle table-striped table-compact" id="tbl">
                <colgroup>
                    <col style="width:88px">
                    <col style="width:70px">
                    <col style="width:70px">
                    <col style="width:70px">
                    <col style="width:86px">
                    <col style="width:86px">
                    <col>
                    <col>
                    <col style="width:64px">
                    <col style="width:58px">
                    <col>
                    <col class="col-autoriza">
                    <col>
                    <col class="col-destino">
                </colgroup>
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Salida</th>
                        <th>Retorno</th>
                        <th class="text-end">Durac.</th>
                        <th>Estado</th>
                        <th>CIP</th>
                        <th>Apellidos</th>
                        <th>Nombres</th>
                        <th class="col-sexo">Sexo</th>
                        <th class="text-end col-edad">Edad</th>
                        <th>Unidad</th>
                        <th class="col-autoriza">Autoriza</th>
                        <th>Motivo</th>
                        <th class="col-destino">Destino</th>
                    </tr>
                </thead>
                <tbody id="tbody"></tbody>
            </table>
        </div>
    </div>

    <!-- Resúmenes -->
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="kpi p-2">
                <div class="small text-muted mb-2">
                    <i class="fa-solid fa-building me-1"></i>Por Unidad (Top 10)
                </div>
                <div id="sumUnidad" style="font-size:var(--fs-sm)"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="kpi p-2">
                <div class="small text-muted mb-2">
                    <i class="fa-solid fa-tags me-1"></i>Motivos (Top 10)
                </div>
                <div id="sumMotivo" style="font-size:var(--fs-sm)"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="kpi p-2">
                <div class="small text-muted mb-2">
                    <i class="fa-solid fa-user-check me-1"></i>Autoriza (Top 10)
                </div>
                <div id="sumAutoriza" style="font-size:var(--fs-sm)"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (()=> {
      const fetchUrl='@Url.Action("Json", "ReporteMovimientos")';
      const exportUrl='@Url.Action("ExportCsv", "ReporteMovimientos")';

      // Filtros
      const $q = qs("#q"), $desde=qs("#desde"), $hasta=qs("#hasta"), $btnClearDates=qs("#btnClearDates");
      const $sexo=qs("#sexo"), $estado=qs("#estado"), $durMin=qs("#durMin"), $durMax=qs("#durMax");
      const mdUnidad = mdrop("#mdUnidad"), mdAutoriza = mdrop("#mdAutoriza"), mdMotivo = mdrop("#mdMotivo"), mdDestino = mdrop("#mdDestino");

      // Acciones
      const $btnClearAll=qs("#btnClearAll"), $btnExport=qs("#btnExport"), $btnPrint=qs("#btnPrint");

      // KPIs
      const $kTotal=qs("#kTotal"), $kPend=qs("#kPend"), $kRet=qs("#kRet"), $kPct=qs("#kPct"), $kAvg=qs("#kAvg"), $kMax=qs("#kMax");

      // Tabla y resúmenes
      const $tbody=qs("#tbody"), $sumUnidad=qs("#sumUnidad"), $sumMotivo=qs("#sumMotivo"), $sumAutoriza=qs("#sumAutoriza");

      let data=[], view=[];

      // Utils
      function qs(s){return document.querySelector(s)}
      const pad2=n=>(n<10?'0':'')+n;
      const minsToHM=m=>{ m=Math.max(0,parseInt(m||0,10)); const h=Math.floor(m/60),mm=m%60; return `${pad2(h)}:${pad2(mm)}`; };
      const deb=(fn,ms)=>{ let t; return(...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a),ms); }; };
      function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

      // MDROP
      function mdrop(sel){
        const root=typeof sel==='string'?document.querySelector(sel):sel;
        const toggle=root.querySelector('.mdrop-toggle');
        const search=root.querySelector('.mdrop-head input[type="text"]');
        const btnAll=root.querySelector('[data-act="all"]'), btnNone=root.querySelector('[data-act="none"]');
        const list=root.querySelector('.mdrop-list'), label=root.querySelector('.mdrop-label');
        let values=[], chosen=new Set();

        toggle.addEventListener('click',(e)=>{e.stopPropagation(); closeAllDrops(root); root.classList.toggle('open'); search.focus();});
        document.addEventListener('click',(e)=>{ if(!root.contains(e.target)) root.classList.remove('open'); });

        btnAll.addEventListener('click',()=>{ values.forEach(v=>chosen.add(v)); renderList(); updateLabel(); fireChanged(); });
        btnNone.addEventListener('click',()=>{ chosen.clear(); renderList(); updateLabel(); fireChanged(); });
        search.addEventListener('input',()=> renderList(search.value.trim().toLowerCase()));

        function renderList(filter=""){
          list.innerHTML = values
            .filter(v=>!filter || v.toLowerCase().includes(filter))
            .map(v=>`<label class="mdrop-item">
                        <input type="checkbox" value="${esc(v)}" ${chosen.has(v)?'checked':''}/>
                        <span class="wrap-2" title="${esc(v)}">${esc(v)}</span>
                     </label>`).join('');
          list.querySelectorAll('input[type="checkbox"]').forEach(chk=>{
            chk.addEventListener('change',()=>{
              const v=chk.value;
              if(chk.checked) chosen.add(v); else chosen.delete(v);
              updateLabel();
              if (search.value){ search.value=''; }
              renderList();
              fireChanged();
            });
          });
        }
        function updateLabel(){
          if(chosen.size===0) label.textContent='Todos';
          else if(chosen.size===1) label.textContent=[...chosen][0];
          else label.textContent=`${chosen.size} seleccionados`;
        }
        function setOptions(arr){
          values = Array.from(new Set(arr.filter(Boolean).map(v=>v.trim()))).sort((a,b)=>a.localeCompare(b));
          chosen = new Set([...chosen].filter(v=>values.includes(v)));
          renderList(); updateLabel();
        }
        function getSelected(){ return [...chosen]; }
        function clear(){ chosen.clear(); updateLabel(); renderList(); fireChanged(); }
        function fireChanged(){ root.dispatchEvent(new CustomEvent('mdrop:change')); }
        return { setOptions, getSelected, clear, root };
      }
      function closeAllDrops(except){
        document.querySelectorAll('.mdrop.open').forEach(el=>{ if(except && el===except) return; el.classList.remove('open'); });
      }

      // Build Query (para servidor). El texto $q se filtra en CLIENTE.
      function buildQuery(){
        const p=new URLSearchParams();
        if($desde.value)  p.set('desde',$desde.value);
        if($hasta.value)  p.set('hasta',$hasta.value);
        if($sexo.value)   p.set('sexo',$sexo.value);
        if($estado.value) p.set('estado',$estado.value);
        if($durMin.value) p.set('durMin',$durMin.value);
        if($durMax.value) p.set('durMax',$durMax.value);
        mdUnidad.getSelected().forEach(v=>p.append('unidad',v));
        mdAutoriza.getSelected().forEach(v=>p.append('autoriza',v));
        mdMotivo.getSelected().forEach(v=>p.append('motivo',v));
        mdDestino.getSelected().forEach(v=>p.append('destino',v));
        return p.toString();
      }

      async function load(){
        const qs=buildQuery();
        const r = await fetch(qs? `${fetchUrl}?${qs}`: fetchUrl, { headers:{'Accept':'application/json'} });
        const js = await r.json();
        data = Array.isArray(js)? js: [];

        // poblar combos (catálogo estable)
        mdUnidad.setOptions(  data.map(x=>x.unidad  ||''));
        mdAutoriza.setOptions(data.map(x=>x.autoriza||''));
        mdMotivo.setOptions(  data.map(x=>x.motivo  ||''));
        mdDestino.setOptions( data.map(x=>x.destino ||''));

        apply(); updateExport();
      }

      function apply(){
        const key = ($q.value||'').trim().toLowerCase();
        view = !key ? data : data.filter(r => [
          r.cip,r.apellidos,r.nombres,r.unidad,r.motivo,r.autoriza,r.destino,r.fecha,r.horaSalida,r.horaRetorno,r.estado
        ].map(x=>(x||'').toString().toLowerCase()).join(' ').includes(key));
        renderTable(); renderKpis(); renderSummaries();
      }

      function tdWrap(v){ v=(v||'').toString(); return `<span class="wrap-2" title="${esc(v)}">${esc(v)}</span>`; }

      function renderTable(){
        $tbody.innerHTML = view.map(r=>{
          const badge = r.estado==='Pendiente'
            ? `<span class="badge" style="background:#fff3cd;color:#8a6d3b;border:1px solid #ffe69c">Pendiente</span>`
            : `<span class="badge" style="background:#e0f2fe;color:#0c4a6e;border:1px solid #bae6fd">Retornado</span>`;
          const dur = r.duracionMin!=null ? minsToHM(r.duracionMin) : '';
          return `<tr>
            <td>${tdWrap(r.fecha)}</td>
            <td>${tdWrap(r.horaSalida)}</td>
            <td>${tdWrap(r.horaRetorno)}</td>
            <td class="text-end">${tdWrap(dur)}</td>
            <td>${badge}</td>
            <td>${tdWrap(r.cip)}</td>
            <td>${tdWrap(r.apellidos)}</td>
            <td>${tdWrap(r.nombres)}</td>
            <td class="col-sexo">${tdWrap(r.sexo)}</td>
            <td class="text-end col-edad">${tdWrap(r.edad??'')}</td>
            <td>${tdWrap(r.unidad)}</td>
            <td class="col-autoriza">${tdWrap(r.autoriza)}</td>
            <td>${tdWrap(r.motivo)}</td>
            <td class="col-destino">${tdWrap(r.destino)}</td>
          </tr>`;
        }).join('');
      }

      function renderKpis(){
        const total=view.length, ret=view.filter(r=>r.estado==='Retornado').length;
        const pend=total-ret, list=view.filter(r=>r.duracionMin!=null).map(r=>r.duracionMin);
        const avg=list.length? Math.round(list.reduce((a,b)=>a+b,0)/list.length) : 0;
        const mx=list.length? Math.max(...list) : 0;
        const pct= total? Math.round(100*ret/total) : 0;
        $kTotal.textContent=total; $kRet.textContent=ret; $kPend.textContent=pend;
        $kPct.textContent=`${pct}%`; $kAvg.textContent=minsToHM(avg); $kMax.textContent=minsToHM(mx);
      }

      function summaryTop10(arr,key){
        const map=new Map();
        for(const r of arr){ const k=(r[key]||'').toString().trim(); if(!k) continue; map.set(k,(map.get(k)||0)+1); }
        return [...map.entries()].sort((a,b)=> b[1]-a[1] || a[0].localeCompare(b[0]) ).slice(0,10);
      }
      function renderPairs($el, pairs){
        $el.innerHTML = pairs.length
          ? pairs.map(([k,v])=>`<div class="d-flex justify-content-between border-bottom" style="padding:.18rem 0">
                                    <span class="wrap-2" title="${esc(k)}">${esc(k)}</span>
                                    <strong>${v}</strong>
                                 </div>`).join('')
          : `<div class="text-muted">Sin datos</div>`;
      }
      function renderSummaries(){
        renderPairs($sumUnidad, summaryTop10(view,'unidad'));
        renderPairs($sumMotivo, summaryTop10(view,'motivo'));
        renderPairs($sumAutoriza, summaryTop10(view,'autoriza'));
      }

      function updateExport(){
        const p=new URLSearchParams();
        if($desde.value)  p.set('desde',$desde.value);
        if($hasta.value)  p.set('hasta',$hasta.value);
        if($sexo.value)   p.set('sexo',$sexo.value);
        if($estado.value) p.set('estado',$estado.value);
        if($durMin.value) p.set('durMin',$durMin.value);
        if($durMax.value) p.set('durMax',$durMax.value);
        mdUnidad.getSelected().forEach(v=>p.append('unidad',v));
        mdAutoriza.getSelected().forEach(v=>p.append('autoriza',v));
        mdMotivo.getSelected().forEach(v=>p.append('motivo',v));
        mdDestino.getSelected().forEach(v=>p.append('destino',v));
        if($q.value) p.set('q',$q.value.trim()); // incluir texto en export
        const qs=p.toString(); $btnExport.href = qs? `${exportUrl}?${qs}`: exportUrl;
      }

      // ===== Eventos (todo automático) =====
      const debLoad = deb(load, 200);
      const debApply = deb(apply, 120);

      // Texto: filtra en cliente en vivo
      $q.addEventListener('input', debApply);

      // Fechas: recarga servidor
      [$desde,$hasta].forEach(el=> el.addEventListener('input', debLoad));

      // Selects simples y números: recarga automática
      [$sexo,$estado,$durMin,$durMax].forEach(el=>{
        el.addEventListener('input', debLoad);
        el.addEventListener('change', debLoad);
      });

      // Multiselects: recarga al cambiar
      [mdUnidad.root, mdAutoriza.root, mdMotivo.root, mdDestino.root].forEach(r=> r.addEventListener('mdrop:change', debLoad));

      // Limpiar SOLO fechas
      $btnClearDates.addEventListener('click', ()=>{
        $desde.value=""; $hasta.value="";
        debLoad();
      });

      // Limpiar TODO
      $btnClearAll.addEventListener('click', ()=>{
        // texto
        $q.value="";
        // fechas
        $desde.value=""; $hasta.value="";
        // selects simples
        $sexo.value=""; $estado.value="";
        // números
        $durMin.value=""; $durMax.value="";
        // multiselects
        mdUnidad.clear(); mdAutoriza.clear(); mdMotivo.clear(); mdDestino.clear();
        // recargar
        debLoad();
      });

      // Imprimir
      $btnPrint.addEventListener('click', ()=> window.print());

      // Init
      load();
    })();
</script>

