@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso denegado</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height:100vh;">
    <div class="container">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h3 class="mb-2 text-danger">403 • Acceso denegado</h3>
                    <p class="mb-3">
                        Esta ruta está protegida. Si está inicializando el sistema, debe proporcionar el
                        <strong>token de instalación</strong> en la URL:
                    </p>
                    <code class="d-inline-block p-2 bg-dark text-white rounded mb-3">
                        /Acceso/RegistrarUsuario?setup=TU_TOKEN
                    </code>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string))
                    {
                        <p class="text-muted mb-0">ReturnUrl: @ViewBag.ReturnUrl</p>
                    }
                    <div class="mt-3">
                        <a class="btn btn-secondary" href="/Acceso/Login">Volver al login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
