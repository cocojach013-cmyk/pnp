@{
    Layout = null;
    var error = ViewBag.MensajeError as string;
    var ok = ViewBag.MensajeOk as string;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Análisis Forense - Ingresar Token</title>

    <!-- Bootstrap 5.3 + FA6 + Inter -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --pnp-green: #00471B;
            --pnp-green-600: #007A33;
            --pnp-green-700: #003715;
            --pnp-gold: #FFD700;
            --pnp-graphite: #2E3B3E;
            --bg-soft: #fafcf9;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        @@media (min-width:576px) {
            html {
                font-size: 15px;
            }
        }

        body {
            margin: 0;
            font-family: Inter,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial;
            color: #1c1f21;
            background: radial-gradient(1200px 600px at 10% -10%, rgba(0,71,27,.06), transparent 60%), radial-gradient(1000px 500px at 110% 10%, rgba(255,215,0,.08), transparent 60%), linear-gradient(180deg,#fff,var(--bg-soft));
        }

        .brand-ribbon {
            height: 6px;
            background: linear-gradient(90deg,var(--pnp-green) 0 35%, var(--pnp-gold) 35% 65%, var(--pnp-green) 65% 100%);
        }

        .canvas {
            min-height: calc(100% - 6px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(16px,3vw,40px);
        }

        .auth-card {
            width: min(100%, 660px);
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(0,0,0,.08);
            border-top: 4px solid var(--pnp-green);
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0,0,0,.06);
            overflow: hidden;
        }

        .auth-header {
            background: linear-gradient(135deg,#384346,#262e31);
            color: #fff;
            border-bottom: 3px solid var(--pnp-gold);
        }

            .auth-header .badge {
                background-color: var(--pnp-gold);
                color: #1a1a1a;
            }

        .brand-badge {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

            .brand-badge img {
                width: 58px;
                height: auto;
            }

        .brand-title small {
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #e5e7eb;
            font-weight: 600;
        }

        .brand-title strong {
            display: block;
            font-weight: 800;
            color: #fff;
            font-size: 1rem;
        }

        .form-label {
            color: #111827;
            font-weight: 600;
        }

        .input-group-text {
            background-color: var(--pnp-graphite);
            color: var(--pnp-gold);
            border-color: var(--pnp-graphite);
        }

        .form-control {
            min-height: 46px;
            color: #0f172a;
            background: #fff;
            border-color: #64748b;
        }

            .form-control:focus {
                border-color: var(--pnp-green-600);
                box-shadow: 0 0 0 .25rem rgba(0,122,51,.18);
            }

        .btn-pnp {
            --bs-btn-color: #fff;
            --bs-btn-hover-color: #fff;
            --bs-btn-active-color: #fff;
            --bs-btn-bg: var(--pnp-green);
            --bs-btn-border-color: var(--pnp-green);
            --bs-btn-hover-bg: var(--pnp-green-700);
            --bs-btn-hover-border-color: var(--pnp-green-700);
            --bs-btn-active-bg: var(--pnp-green-700);
            --bs-btn-active-border-color: var(--pnp-green-700);
        }

        .btn-outline-pnp {
            color: var(--pnp-green-600);
            border-color: var(--pnp-green-600);
            background: #fff;
        }

            .btn-outline-pnp:hover {
                background: #f3f4f6;
                color: var(--pnp-green-700);
            }

        .card-footer {
            border-top: 3px solid var(--pnp-gold);
            background: #fff;
        }

        .footer-note {
            color: #6b7280;
            font-size: .9rem;
        }

        @@media (prefers-color-scheme:dark) {
            body {
                background: linear-gradient(180deg,#121617,#171c1e);
                color: #e5e7eb;
            }

            .auth-card {
                background: rgba(22,27,29,.92);
                border-color: rgba(255,255,255,.05);
            }

            .input-group-text {
                background: #1b2225;
                color: var(--pnp-gold);
                border-color: #1b2225;
            }

            .form-control {
                background: #0f1416;
                color: #e5e7eb;
                border-color: #2d3a3f;
            }

            .card-footer {
                background: #121617;
            }

            .footer-note {
                color: #9ca3af;
            }
        }
    </style>
</head>
<body>
    <div class="brand-ribbon"></div>
    <main class="canvas">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-header py-3 px-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="brand-badge">
                        <img src="~/Imagenes/Escudo.png" alt="Escudo PNP">
                        <div class="brand-title">
                            <small>Policía Nacional del Perú</small>
                            <strong>Token de instalación</strong>
                        </div>
                    </div>
                    <span class="badge rounded-pill"><i class="fa-solid fa-key me-1"></i> Requerido</span>
                </div>
            </div>

            <!-- Body -->
            <div class="p-4 p-md-5">
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>@error</div>
                }
                else if (!string.IsNullOrWhiteSpace(ok))
                {
                    <div class="alert alert-success"><i class="fa-solid fa-circle-check me-1"></i>@ok</div>
                }

                <form asp-controller="Acceso" asp-action="IngresarToken" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="mb-3">
                        <label class="form-label" for="setup">Token</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-fingerprint"></i></span>
                            <input class="form-control"
                                   id="setup"
                                   name="setup"
                                   type="password"
                                   inputmode="text"
                                   placeholder="Pegue su token aquí"
                                   required
                                   autocomplete="one-time-code" />
                            <button class="btn btn-outline-pnp" type="button" id="togglePwd" title="Mostrar/Ocultar token">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted">Este token habilita el registro del primer usuario administrador.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-pnp fw-semibold">
                            <i class="fa-solid fa-unlock-keyhole me-1"></i> Validar y continuar
                        </button>
                        <a asp-controller="Acceso" asp-action="Login" class="btn btn-outline-pnp">
                            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Login
                        </a>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="card-footer text-center py-3">
                <div class="footer-note">
                    <i class="fa-solid fa-shield-halved me-1" style="color: var(--pnp-green);"></i>
                    © @DateTime.Now.Year • PNP • Seguridad y Disciplina
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const btn = document.getElementById('togglePwd');
            const input = document.getElementById('setup');
            if (btn && input) {
                btn.addEventListener('click', function () {
                    const ico = btn.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        ico.classList.replace('fa-eye', 'fa-eye-slash');
                    } else {
                        input.type = 'password';
                        ico.classList.replace('fa-eye-slash', 'fa-eye');
                    }
                    input.focus();
                });
            }
        })();
    </script>
</body>
</html>
