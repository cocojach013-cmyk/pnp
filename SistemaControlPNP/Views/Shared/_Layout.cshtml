@using System.Security.Claims
@{
    ViewData["Title"] = ViewData["Title"] ?? "Sistema de Control PNP";

    var userName = User?.Identity?.Name ?? "Usuario";
    var userGrado = User?.Claims?.FirstOrDefault(c => c.Type == "Grado")?.Value ?? "";
    var userRole = User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Sin rol";

    var fotoClaim = User?.Claims?.FirstOrDefault(c => c.Type == "FotoUrl")?.Value;
    var placeholder = Url.Content("~/Imagenes/sin-perfil.jpg");
    var avatarUrl = string.IsNullOrWhiteSpace(fotoClaim) ? placeholder : fotoClaim;

    var path = Context?.Request?.Path ?? "/";

    bool isLoginPage =
        path.StartsWithSegments("/Acceso/Login") ||
        path.StartsWithSegments("/Acceso/RegistrarUsuario");

    bool isAuthenticated = User?.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 4.5.2 + FontAwesome 5 -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/Style/layout-pnp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Style/form-styles.css" asp-append-version="true" />

    <style>
        /* ====== Z-index institucional ====== */
        .brand-ribbon {
            z-index: 1020 !important;
        }

        header {
            z-index: 1030 !important;
        }

        .sidebar {
            z-index: 1010 !important;
        }

        .modal-backdrop {
            z-index: 1040 !important;
        }

        .modal {
            z-index: 1050 !important;
        }

        /* ====== Safe-area global (cinta + topbar) ====== */
        :root {
            --ribbon-h: 4px; /* ajusta según tu ribbon real */
            --header-h: 56px; /* altura base del topbar */
            --safe-offset: calc(var(--ribbon-h) + var(--header-h));
            --sidebar-w-dyn: 0px; /* medido por JS */
        }

        .brand-ribbon {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
        }

        header {
            position: fixed;
            top: var(--ribbon-h);
            left: 0;
            right: 0;
        }

        /* Empuja TODO el contenido del body por debajo del header */
        .has-topbar .content {
            padding-top: calc(var(--safe-offset) + 12px);
            padding-bottom: 0; /* sin espacio extra inferior */
            min-height: 100vh;
        }

        /* ====== Avatares ====== */
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .avatar-mini {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: .5rem;
            flex-shrink: 0;
            border: 1px solid #e5e7eb;
        }

        .avatar-preview {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            background: #fff;
        }

        /* ============================================================
                                   Menú “ajustado al texto” + off-canvas móvil
                                   ============================================================ */
        .menu-links a {
            width: auto;
        }

        .menu-section {
            width: auto;
        }

        .menu-scroll {
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }

            .menu-scroll > *:last-child {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
            }

        /* Desktop: sidebar fijo ajustado al contenido */
        @@media (min-width:769px) {
            .sidebar {
                position: fixed;
                top: var(--safe-offset);
                left: 0;
                bottom: 0;
                width: max-content;
                max-width: 40vw;
                padding-right: 8px;
                background: transparent !important;
                border-right: 1px solid rgba(255,215,0,.25);
                box-shadow: none;
                transform: none !important;
            }

            .content {
                padding-left: var(--sidebar-w-dyn, var(--sidebar-w)) !important;
            }
        }

        /* Móvil: off-canvas desde el cuerpo */
        @@media (max-width:768px) {
            .sidebar {
                position: absolute !important;
                top: var(--safe-offset);
                left: 0;
                bottom: 0;
                width: fit-content;
                max-width: 92vw;
                padding-right: 8px;
                background: #ffffff !important;
                border-right: 1px solid var(--line) !important;
                box-shadow: 12px 0 24px rgba(0,0,0,.18);
                transform: translateX(-100%) !important;
                overflow: auto;
            }

            body.sidebar-open .sidebar {
                transform: translateX(0) !important;
            }

            .content {
                padding-left: 0 !important;
            }
        }

        .menu-links {
            padding-right: 6px;
            margin-bottom: 0;
        }

            .menu-links a, .submenu .menu-links a {
                display: inline-flex;
                padding: 7px 10px;
                border-radius: 9px;
                margin-bottom: 2px;
            }

        .sidebar a.active-menu {
            display: inline-flex;
        }

        .menu-scroll .menu-links, .submenu .menu-links {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 4px;
        }

            .menu-links a, .submenu .menu-links a {
                display: inline-flex !important;
                width: auto !important;
                max-width: none !important;
                white-space: nowrap !important;
            }

        .submenu {
            margin-bottom: 4px;
        }

        /* ============================================================
                                   Alineación uniforme de flechas ">" (caret)
                                   ============================================================ */
        .menu-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 6px 10px;
            border: none;
            background: transparent;
            color: #fff;
            font-weight: 600;
            font-family: "Inter", system-ui, sans-serif;
            letter-spacing: .02em;
            text-align: left;
            border-radius: 8px;
            transition: background .2s ease;
            margin-bottom: 4px;
        }

            .menu-section:hover {
                background: rgba(255,255,255,.1);
            }

            .menu-section .caret {
                font-size: .85rem;
                margin-left: 10px;
                flex-shrink: 0;
                align-self: center;
                opacity: .9;
            }

            .menu-section .label {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-grow: 1;
            }

        /* FAB del menú */
        .sidebar-fab {
            position: fixed;
            left: max(14px, env(safe-area-inset-left));
            top: calc(var(--safe-offset) + 10px);
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: none;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,.08);
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(0,0,0,.18);
            line-height: 1;
            z-index: 1025;
        }

            .sidebar-fab i {
                font-size: 20px;
            }

        @@media (max-width: 768px) {
            .sidebar-fab {
                display: flex;
            }

            .content .container-fluid {
                padding-left: 56px;
            }

            body.sidebar-open .sidebar-fab {
                opacity: 0;
                pointer-events: none;
                transition: opacity .15s ease;
            }
        }

        /* ====== Ajustes generales de contenido ====== */
        html, body {
            height: 100%;
        }

        body {
            margin: 0;
        }

        .content main {
            margin: 0;
        }

        .app-zoom, .page-viewport {
            margin: 0;
            padding-bottom: 0;
        }

        /* ===== Ocultar barra inferior del menú (solo sidebar) ===== */
        .sidebar {
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        .menu-scroll {
            overflow-x: hidden !important;
            padding-bottom: 0 !important;
            margin-bottom: 0 !important;
        }

        .menu-links a,
        .menu-section,
        .submenu {
            max-width: 100% !important;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        .sidebar::-webkit-scrollbar:horizontal,
        .menu-scroll::-webkit-scrollbar:horizontal {
            height: 0 !important;
        }

        .sidebar,
        .menu-scroll {
            clip-path: inset(0 0 0 0);
        }

            /* Sidebar: filas apiladas + caret alineado */
            .menu-scroll .menu-links {
                display: flex !important;
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 6px;
                margin: 6px 0 10px 0;
            }

        .menu-links a {
            display: flex !important;
            align-items: center;
            width: 100% !important;
            max-width: 100% !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding: 7px 12px;
            border-radius: 10px;
        }

        .menu-section {
            position: relative;
            display: flex !important;
            align-items: center;
            justify-content: flex-start;
            width: 100% !important;
            padding: 8px 34px 8px 12px;
            border-radius: 12px;
            margin: 4px 0;
        }

            .menu-section .caret {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                margin: 0 !important;
                opacity: .95;
                pointer-events: none;
            }

        .submenu {
            margin: 4px 0 2px 0;
        }

            .submenu .menu-links a {
                width: 100% !important;
                max-width: 100% !important;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                padding: 7px 12px;
            }

        .sidebar,
        .menu-scroll {
            overflow-x: hidden !important;
        }

        .menu-section .label {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        /* ===== Modal de éxito pequeñito con check y dos líneas ===== */
        .modal-success-mini .modal-content {
            border-radius: 12px;
        }

        .modal-success-mini .modal-body {
            padding: .55rem .85rem;
        }

        .modal-success-mini .success-icon {
            font-size: 1.6rem;
            color: #16a34a;
            margin-bottom: .15rem;
        }

        .modal-success-mini #genericSuccessLine1 {
            font-size: .9rem;
            font-weight: 600;
            margin-bottom: 0;
        }

        .modal-success-mini #genericSuccessLine2 {
            font-size: .8rem;
            margin-bottom: 0;
        }

        /* ===== FIX extra: que el óvalo del menú no se corte al pasar el cursor ===== */
        .menu-links a,
        .menu-section {
            box-sizing: border-box; /* ancho incluye padding */
        }

        .menu-scroll {
            padding-right: 20px !important; /* más aire a la derecha para que no se corte el óvalo */
        }

        /* =========================================================
                           MODALES COMPACTOS: CAMBIAR CONTRASEÑA / CAMBIAR FOTO
                           ========================================================= */

        /* Tamaño más pequeño y centrado */
        #changePwdModal .modal-dialog,
        #changeAvatarModal .modal-dialog {
            max-width: 340px !important;
            width: min(92vw, 340px) !important;
            margin: 1.2rem auto !important;
        }

        /* Cuerpo 3D suave, redondeado */
        #changePwdModal .modal-content,
        #changeAvatarModal .modal-content {
            border-radius: 16px;
            border: 1px solid rgba(15, 23, 42, 0.12);
            background: radial-gradient(circle at 0 0, rgba(0,71,27,.12), transparent 55%), radial-gradient(circle at 100% 100%, rgba(255,215,0,.12), transparent 55%), #f3f7f5;
            box-shadow: 0 16px 38px rgba(15, 23, 42, 0.28);
            overflow: hidden;
        }

        /* Header compacto, usando el mismo degradado PNP */
        #changePwdModal .modal-header,
        #changeAvatarModal .modal-header {
            padding: .4rem .85rem;
            min-height: 40px;
            align-items: center;
        }

        #changePwdModal .modal-title,
        #changeAvatarModal .modal-title {
            font-size: .85rem;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        /* Cuerpo más compacto */
        #changePwdModal .modal-body,
        #changeAvatarModal .modal-body {
            background: transparent;
            padding: .7rem .9rem .8rem;
            font-size: .85rem;
        }

        /* Formularios compactos dentro de estos modales */
        #changePwdModal .form-group,
        #changeAvatarModal .form-group {
            margin-bottom: .4rem;
        }

        #changePwdModal .form-label,
        #changeAvatarModal .form-label {
            font-size: .78rem;
            font-weight: 600;
            margin-bottom: .15rem;
        }

        /* Inputs más pequeños pero legibles */
        #changePwdModal .form-control,
        #changeAvatarModal .form-control,
        #changeAvatarModal .form-control-file {
            font-size: .82rem;
            padding: .28rem .45rem;
            border-radius: .45rem;
        }

        /* Texto de ayuda más pequeño */
        #changePwdModal .form-text,
        #changeAvatarModal .form-text,
        #changePwdModal small,
        #changeAvatarModal small {
            font-size: .72rem;
        }

        /* Botones redondeados y un poco más protagonistas */
        #changePwdModal .btn-responsive,
        #changeAvatarModal .btn-responsive,
        #changePwdModal .btn,
        #changeAvatarModal .btn {
            border-radius: 999px;
            font-size: .82rem;
            padding: .32rem 1.1rem;
        }

        /* Botón primario con efecto 3D */
        #changePwdModal .btn-primary,
        #changeAvatarModal .btn-primary {
            box-shadow: 0 8px 18px rgba(0,122,51,.45);
            transform: translateY(0);
            transition: transform .12s ease-out, box-shadow .12s ease-out;
        }

            #changePwdModal .btn-primary:hover,
            #changeAvatarModal .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(0,122,51,.60);
            }

            #changePwdModal .btn-primary:active,
            #changeAvatarModal .btn-primary:active {
                transform: translateY(0);
                box-shadow: 0 4px 10px rgba(0,122,51,.55);
            }

        /* Centrar mejor el botón en ambos modales */
        #changePwdModal .modal-body .mt-3.d-flex,
        #changeAvatarModal .modal-body .mt-3.d-flex {
            margin-top: .55rem !important;
        }

        /* Alerta de error más pequeña y pill */
        #changePwdModal .alert-single-line,
        #changeAvatarModal .alert-single-line {
            border-radius: 999px;
            padding: .25rem .6rem;
            font-size: .78rem;
            margin-bottom: .5rem;
        }

        /* =========================================================
                           CAMBIAR FOTO – Input de archivo 3D atractivo
                           ========================================================= */

        /* Contenedor un poquito más ordenado */
        #changeAvatarModal #changeAvatarForm .form-group {
            margin-bottom: .45rem;
        }

        /* Wrapper para input + botón X */
        #changeAvatarModal .avatar-file-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        /* Estilo base del input de archivo */
        #changeAvatarModal #avatarFile {
            font-size: .8rem;
            border-radius: 999px;
            padding: .25rem 2.4rem .25rem .65rem; /* espacio a la derecha para la X */
            border: 1px solid rgba(15, 23, 42, .12);
            background: linear-gradient(145deg, #ffffff, #edf2f7);
            box-shadow: 0 6px 14px rgba(15, 23, 42, .18), 0 0 0 1px rgba(255, 255, 255, .9) inset;
            color: #374151;
            width: 100%;
            cursor: pointer;
            transition: box-shadow .15s ease-out, transform .12s ease-out, border-color .15s ease-out, background .15s ease-out;
        }

            /* Botón interno del input (navegadores modernos) */
            #changeAvatarModal #avatarFile::file-selector-button {
                border: none;
                border-radius: 999px;
                padding: .28rem .85rem;
                margin-right: .6rem;
                background: linear-gradient(135deg, #0b7a3a, #045120);
                color: #f9fafb;
                font-weight: 600;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                box-shadow: 0 5px 12px rgba(4, 120, 87, .55);
                cursor: pointer;
            }

            /* Compatibilidad WebKit antigua */
            #changeAvatarModal #avatarFile::-webkit-file-upload-button {
                border: none;
                border-radius: 999px;
                padding: .28rem .85rem;
                margin-right: .6rem;
                background: linear-gradient(135deg, #0b7a3a, #045120);
                color: #f9fafb;
                font-weight: 600;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                box-shadow: 0 5px 12px rgba(4, 120, 87, .55);
                cursor: pointer;
            }

            /* Hover / active – efecto 3D */
            #changeAvatarModal #avatarFile:hover {
                box-shadow: 0 9px 20px rgba(15, 23, 42, .25), 0 0 0 1px rgba(255, 255, 255, .95) inset;
                transform: translateY(-1px);
                border-color: rgba(0, 122, 51, .55);
            }

            #changeAvatarModal #avatarFile:active {
                box-shadow: 0 4px 10px rgba(15, 23, 42, .2), 0 0 0 1px rgba(255, 255, 255, .95) inset;
                transform: translateY(0);
            }

        /* Botón "X" para limpiar selección de archivo */
        #changeAvatarModal .avatar-file-clear {
            position: absolute;
            right: .38rem;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            color: #fff;
            font-size: .65rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 3px 8px rgba(0,0,0,.35);
            cursor: pointer;
            padding: 0;
        }

            #changeAvatarModal .avatar-file-clear:hover {
                background: linear-gradient(135deg, #f97373, #dc2626);
            }

            #changeAvatarModal .avatar-file-clear:active {
                box-shadow: 0 1px 4px rgba(0,0,0,.4);
                transform: translateY(-50%) translateY(1px);
            }

        /* Encabezado más fino del modal "Salir del sistema" */
        #logoutConfirmModal .modal-header {
            background: linear-gradient(90deg,#002e12,#004018);
            border-bottom: 3px solid var(--pnp-gold);
            padding: .45rem .85rem; /* 🔹 reduce altura del header */
            min-height: 42px; /* 🔹 header compacto */
            align-items: center;
        }

        #logoutConfirmModal .modal-title {
            font-size: .80rem; /* 🔹 título más fino */
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            color: #f9fafb;
            margin: 0;
        }

    </style>
</head>

<body class="@(isLoginPage ? "" : "has-topbar")">
    <!-- Cinta institucional superior -->
    <div class="brand-ribbon"></div>

    @* Redirección si no está autenticado y no es Login/Registro *@
    @if (!isAuthenticated && !isLoginPage)
    {
        <script>window.location.href='/Acceso/Login';</script>
    }

    @* ===== Topbar (oculto en Login/RegistrarUsuario) ===== *@
    @if (!isLoginPage)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark topbar" role="navigation">
                <div class="container-fluid d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center topbar-group-left">
                        <div class="pnp-brand d-flex align-items-center gap-2">
                            <img src="~/Imagenes/Escudo.png" alt="PNP" class="brand-logo">
                            <div class="brand">
                                <small>POLICÍA NACIONAL DEL PERÚ</small>
                                <span>SISTEMA DE CONTROL DE ASISTENCIA</span>
                            </div>
                        </div>

                        <span class="topbar-divider" aria-hidden="true"></span>
                        <div class="topbar-section-title" id="headerSectionTitle">Inicio</div>
                    </div>

                    <!-- Usuario -->
                    <div class="nav-user dropdown position-static">
                        <div id="userMenuToggle"
                             class="d-flex align-items-center user-summary dropdown-toggle"
                             data-toggle="dropdown"
                             data-display="static"
                             data-boundary="viewport"
                             data-offset="0,8"
                             aria-haspopup="true"
                             aria-expanded="false"
                             role="button">
                            <img id="topAvatar"
                                 src="@avatarUrl"
                                 alt="Usuario"
                                 class="avatar"
                                 onerror="this.onerror=null;this.src='@placeholder';" />
                            <div class="user-labels">
                                <span class="name">@userName</span>
                                @if (!string.IsNullOrWhiteSpace(userGrado))
                                {
                                    <span class="grade">@userGrado</span>
                                }
                                <span class="role">@userRole</span>
                            </div>
                        </div>

                        <div class="dropdown-menu dropdown-menu-right">
                            <button class="dropdown-item d-flex align-items-center" id="btnOpenChangeAvatar">
                                <img id="dropdownAvatar"
                                     src="@avatarUrl"
                                     alt="Foto perfil"
                                     class="avatar-mini"
                                     onerror="this.onerror=null;this.src='@placeholder';" />
                                <span>Cambiar foto de perfil</span>
                            </button>
                            <button class="dropdown-item" id="btnOpenChangePwd">
                                <i class="fas fa-key mr-2"></i> Cambiar contraseña
                            </button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item text-danger" id="btnLogoutDropdown">
                                <i class="fas fa-sign-out-alt mr-2"></i> Salir
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <!-- Botón FAB menú móvil -->
    <button id="sidebarFab" class="sidebar-fab d-md-none" type="button" aria-label="Menú">
        <i class="fas fa-bars"></i>
    </button>

    @* ===== Sidebar ===== *@
    @if (isAuthenticated && !isLoginPage)
    {
        <aside class="sidebar">
            <div class="fixed-top-block">
                <div class="user-info"></div>
            </div>

            <div class="menu-scroll">
                <!-- Inicio -->
                <div class="menu-links">
                    <a href="@Url.Action("Index", "Dashboard")"
                       class="menu-link menu-link-root"
                       data-section="Inicio" data-submenu="">
                        <i class="fas fa-home"></i> Inicio
                    </a>
                </div>

                <!-- Operación -->
                <button class="menu-section collapsed" data-toggle="collapse" data-target="#secOperacion">
                    <div class="label"><i class="fas fa-clipboard-check"></i> Operación</div>
                    <i class="fas fa-chevron-down caret"></i>
                </button>
                <div id="secOperacion" class="collapse submenu">
                    <div class="menu-links">
                        <a href="@Url.Action("ListaAsistencia", "Asistencia")"
                           class="menu-link"
                           data-section="Operación" data-submenu="Asistencia">
                            <i class="fas fa-user-check"></i> Asistencia
                        </a>

                        <a href="@Url.Action("ListaMovimiento", "Movimiento")"
                           class="menu-link"
                           data-section="Operación" data-submenu="Movimientos">
                            <i class="fas fa-route"></i> Movimientos
                        </a>
                    </div>
                </div>

                <!-- Personal -->
                <button class="menu-section collapsed" data-toggle="collapse" data-target="#secPersonal">
                    <div class="label"><i class="fas fa-id-badge"></i> Personal</div>
                    <i class="fas fa-chevron-down caret"></i>
                </button>
                <div id="secPersonal" class="collapse submenu">
                    <div class="menu-links">
                        <a href="@Url.Action("ListaPersonal", "Personal")"
                           class="menu-link"
                           data-section="Personal" data-submenu="Listado">
                            <i class="fas fa-list-ul"></i> Lista
                        </a>
                    </div>
                </div>

                <!-- Administración -->
                @if (userRole == "Administrador")
                {
                    <button class="menu-section collapsed" data-toggle="collapse" data-target="#secAdmin">
                        <div class="label"><i class="fas fa-cog"></i> Administración</div>
                        <i class="fas fa-chevron-down caret"></i>
                    </button>
                    <div id="secAdmin" class="collapse submenu">
                        <div class="menu-links">
                            <a href="@Url.Action("ListaUsuarios", "Usuarios")"
                               class="menu-link"
                               data-section="Administración" data-submenu="Usuarios">
                                <i class="fas fa-users-cog"></i> Usuarios
                            </a>

                            <a href="@Url.Action("ListaAuditoria", "Auditoria")"
                               class="menu-link"
                               data-section="Administración" data-submenu="Auditoría">
                                <i class="fas fa-history"></i> Auditoría
                            </a>
                        </div>
                    </div>
                }

                <!-- Reportes -->
                <button class="menu-section collapsed" data-toggle="collapse" data-target="#secReportes">
                    <div class="label"><i class="fas fa-chart-bar"></i> Reportes</div>
                    <i class="fas fa-chevron-down caret"></i>
                </button>
                <div id="secReportes" class="collapse submenu">
                    <div class="menu-links">
                        <a href="@Url.Action("Asistencia", "Reportes")"
                           class="menu-link"
                           data-section="Reportes" data-submenu="Asistencia">
                            <i class="fas fa-file-alt"></i> Asistencia
                        </a>
                        <a href="@Url.Action("Movimientos", "Reportes")"
                           class="menu-link"
                           data-section="Reportes" data-submenu="Movimientos">
                            <i class="fas fa-file-export"></i> Movimientos
                        </a>
                        <a href="@Url.Action("Personal", "Reportes")"
                           class="menu-link"
                           data-section="Reportes" data-submenu="Personal">
                            <i class="fas fa-user-tie"></i> Personal
                        </a>
                    </div>
                </div>
            </div>
        </aside>
    }

    <!-- ===== Contenido ===== -->
    <div class="content">
        <main role="main" class="pb-3">
            <div class="app-zoom">
                <div class="page-viewport">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    @* ===== Modales ===== *@

    <!-- Cambiar Contraseña -->
    <div class="modal fade" id="changePwdModal" tabindex="-1" role="dialog" aria-labelledby="changePwdLabel" aria-hidden="true"
         data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changePwdLabel">Cambiar contraseña</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div id="changePwdAlert" class="alert alert-danger alert-single-line" style="display:none;"></div>
                    <form id="changePwdForm" class="form-compact" autocomplete="off">
                        <div class="form-group">
                            <label class="form-label">Contraseña actual</label>
                            <input type="password" class="form-control" name="oldPassword" id="oldPassword" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nueva contraseña</label>
                            <input type="password" class="form-control" name="newPassword" id="newPassword" required>
                            <small class="form-text text-muted">Mín. 6, con mayúscula, minúscula, número y símbolo (! % * ? &).</small>
                        </div>
                        <div class="form-group d-none" id="groupConfirm">
                            <label class="form-label">Confirmar nueva contraseña</label>
                            <input type="password" class="form-control" name="confirmPassword" id="confirmPassword">
                        </div>
                        <div class="mt-3 d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary btn-responsive">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Cambiar Foto de Perfil -->
    <div class="modal fade" id="changeAvatarModal" tabindex="-1" role="dialog" aria-labelledby="changeAvatarLabel" aria-hidden="true"
         data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeAvatarLabel">Cambiar foto de perfil</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div id="changeAvatarAlert" class="alert alert-danger alert-single-line" style="display:none;"></div>

                    <div class="d-flex flex-column align-items-center mb-2">
                        <img id="avatarPreview" class="avatar-preview"
                             src="@avatarUrl"
                             alt="Previsualización"
                             onerror="this.onerror=null;this.src='@placeholder';" />
                        <div class="small-muted mt-2 text-center">Formatos: JPG, PNG, WEBP. Máx: 2MB.</div>
                    </div>

                    <form id="changeAvatarForm" class="form-compact" autocomplete="off" enctype="multipart/form-data">
                        <div class="form-group">
                            <label class="form-label">Seleccionar imagen</label>
                            <div class="avatar-file-wrap">
                                <input type="file" class="form-control-file" id="avatarFile" name="avatar"
                                       accept="image/jpeg,image/png,image/webp" />
                                <button type="button"
                                        id="avatarFileClear"
                                        class="avatar-file-clear"
                                        title="Quitar imagen seleccionada">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mt-3 d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary btn-responsive">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmar Salida -->
    <!-- Confirmar Salida -->
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" role="dialog" aria-labelledby="logoutConfirmLabel" aria-hidden="true"
         data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:250px;width:min(94vw,420px);">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutConfirmLabel">Salir del sistema</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span class="sr-only">Cerrar</span>
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <div class="mb-2">
                        <i class="fas fa-sign-out-alt fa-3x text-danger"></i>
                    </div>
                    <p class="mb-0">¿Está seguro de cerrar sesión?</p>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmLogoutModal">
                        <span class="spinner-border spinner-border-sm mr-2 d-none" role="status" aria-hidden="true"></span>
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal genérico de éxito (pequeño, con check y dos líneas) -->
    <div class="modal fade" id="genericSuccessModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-success-mini" role="document"
             style="max-width:300px;width:min(80vw,300px);">
            <div class="modal-content text-center">
                <div class="modal-body">
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p id="genericSuccessLine1" class="mb-0">Operación exitosa</p>
                    <p id="genericSuccessLine2" class="mb-0">Actualizado correctamente.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery / Popper / Bootstrap 4 -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" crossorigin="anonymous"></script>

    <!-- Token antifalsificación global oculto -->
    <form id="af-global" style="display:none;">@Html.AntiForgeryToken()</form>

    <script>
        (function () {
            try { $.fn.dropdown.Constructor.Default.flip = false; } catch (e) { }
            const d = document;

            function csrf() {
                const inp = d.querySelector('input[name="__RequestVerificationToken"]');
                return inp ? inp.value : '';
            }
            function bump(url) {
                try {
                    const u = new URL(url, window.location.origin);
                    u.searchParams.set('_', Date.now().toString());
                    return u.pathname + u.search;
                } catch { return url + (url.indexOf('?') > -1 ? '&' : '?') + '_=' + Date.now(); }
            }

            function setSidebarWidthVar() {
                const sb = d.querySelector('.sidebar');
                if (!sb) return;
                if (window.innerWidth >= 769) {
                    const w = sb.offsetWidth || 0;
                    d.documentElement.style.setProperty('--sidebar-w-dyn', w + 'px');
                } else {
                    d.documentElement.style.setProperty('--sidebar-w-dyn', '0px');
                }
            }

            function setSafeOffset() {
                const ribbon = d.querySelector('.brand-ribbon');
                const header = d.querySelector('header');
                const rh = ribbon ? ribbon.offsetHeight : 0;
                const hh = header ? header.offsetHeight : 0;
                d.documentElement.style.setProperty('--safe-offset', (rh + hh) + 'px');
            }

            d.addEventListener('DOMContentLoaded', function () {
                $('.modal').each(function () { $(this).appendTo('body'); });
                $(document).on('shown.bs.modal', function (e) {
                    var $m = $(e.target);
                    if (!$m.parent().is('body')) $m.appendTo('body');
                });

                /* FAB menú móvil */
                const fab = d.getElementById('sidebarFab');
                if (fab) {
                    fab.addEventListener('click', function (e) {
                        e.stopPropagation();
                        d.body.classList.toggle('sidebar-open');
                    });
                }
                d.addEventListener('click', function (e) {
                    if (window.innerWidth >= 769) return;
                    if (!d.body.classList.contains('sidebar-open')) return;
                    const sb = d.querySelector('.sidebar');
                    const fabBtn = d.getElementById('sidebarFab');
                    if (sb && !sb.contains(e.target) && fabBtn && !fabBtn.contains(e.target)) {
                        d.body.classList.remove('sidebar-open');
                    }
                });

                /* === Cambiar contraseña === */
                const openPwdBtn = d.getElementById('btnOpenChangePwd');
                if (openPwdBtn) {
                    openPwdBtn.addEventListener('click', function () {
                        const f = d.getElementById('changePwdForm');
                        const alertBox = d.getElementById('changePwdAlert');
                        if (alertBox) { alertBox.textContent = ''; alertBox.style.display = 'none'; }
                        if (f) f.reset();
                        d.getElementById('groupConfirm')?.classList.add('d-none');
                        $('#changePwdModal').modal({ backdrop: 'static', keyboard: false, show: true });
                        setTimeout(() => d.getElementById('oldPassword')?.focus(), 160);
                    });
                }
                const newPwd = d.getElementById('newPassword');
                const groupConfirm = d.getElementById('groupConfirm');
                if (newPwd && groupConfirm) {
                    newPwd.addEventListener('input', function () {
                        if ((this.value || '').trim().length > 0) groupConfirm.classList.remove('d-none');
                        else {
                            groupConfirm.classList.add('d-none');
                            const c = d.getElementById('confirmPassword'); if (c) c.value = '';
                        }
                    });
                }
                const formPwd = d.getElementById('changePwdForm');
                if (formPwd) {
                    formPwd.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const alertBox = d.getElementById('changePwdAlert');
                        const show = (m) => { if (alertBox) { alertBox.textContent = m; alertBox.style.display = 'block'; } };

                        const oldPassword = d.getElementById('oldPassword').value.trim();
                        const newPassword = d.getElementById('newPassword').value.trim();
                        const confirmPassword = d.getElementById('confirmPassword').value.trim();

                        if (!oldPassword || !newPassword) { show('Completa todos los campos.'); return; }
                        if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!%*?&]).{6,}$/.test(newPassword)) { show('La contraseña no cumple los requisitos.'); return; }
                        if (!groupConfirm.classList.contains('d-none')) {
                            if (!confirmPassword) { show('Completa la confirmación.'); return; }
                            if (newPassword !== confirmPassword) { show('La nueva contraseña y la confirmación no coinciden.'); return; }
                        }
                        if (oldPassword === newPassword) { show('La nueva contraseña no puede ser igual a la actual.'); return; }

                        $.ajax({
                            url: '@Url.Action("CambiarClave", "Acceso")',
                            type: 'POST',
                            headers: { 'RequestVerificationToken': csrf() },
                            data: { oldPassword, newPassword, confirmPassword },
                            success: function (resp) {
                                if (resp && resp.success) {
                                    $('#changePwdModal').modal('hide');

                                    $('#genericSuccessLine1').text('Operación exitosa');
                                    $('#genericSuccessLine2').text(resp.message || 'Tu contraseña se actualizó correctamente.');

                                    $('#genericSuccessModal').modal('show');

                                    setTimeout(function () {
                                        $('#genericSuccessModal').modal('hide');
                                    }, 1800);
                                } else {
                                    show((resp && resp.message) || 'No se pudo actualizar la contraseña.');
                                }
                            },
                            error: function () { show('Error de red/servidor.'); }
                        });
                    });
                }

                /* === Cambiar foto === */
                const openAvatarBtn = d.getElementById('btnOpenChangeAvatar');
                if (openAvatarBtn) {
                    openAvatarBtn.addEventListener('click', function () {
                        const err = d.getElementById('changeAvatarAlert');
                        if (err) { err.textContent = ''; err.style.display = 'none'; }
                        const currentSrc = document.getElementById('topAvatar').getAttribute('src');
                        const prev = d.getElementById('avatarPreview'); if (prev) prev.src = currentSrc || '@placeholder';
                        const file = d.getElementById('avatarFile'); if (file) file.value = '';
                        $('#changeAvatarModal').modal({ backdrop: 'static', keyboard: false, show: true });
                    });
                }
                const fileInput = d.getElementById('avatarFile');
                const fileClearBtn = d.getElementById('avatarFileClear');

                if (fileClearBtn && fileInput) {
                    fileClearBtn.addEventListener('click', function () {
                        const err = d.getElementById('changeAvatarAlert');
                        if (err) { err.textContent = ''; err.style.display = 'none'; }

                        // Vaciar input
                        fileInput.value = '';

                        // Volver a mostrar la foto actual (o placeholder)
                        const prev = d.getElementById('avatarPreview');
                        const top = d.getElementById('topAvatar');
                        const fallback = '@placeholder';
                        if (prev) {
                            const src = top ? (top.getAttribute('src') || fallback) : fallback;
                            prev.src = src;
                        }
                    });
                }

                if (fileInput) {
                    fileInput.addEventListener('change', function () {
                        const err = d.getElementById('changeAvatarAlert');
                        if (err) { err.textContent = ''; err.style.display = 'none'; }
                        const f = this.files && this.files[0];
                        if (!f) return;

                        const okType = ['image/jpeg', 'image/png', 'image/webp'].includes(f.type);
                        if (!okType) { this.value = ''; if (err) { err.textContent = 'Formato no permitido. Usa JPG, PNG o WEBP.'; err.style.display = 'block'; } return; }

                        const max = 2 * 1024 * 1024;
                        if (f.size > max) { this.value = ''; if (err) { err.textContent = 'La imagen supera 2MB.'; err.style.display = 'block'; } return; }

                        const reader = new FileReader();
                        reader.onload = e => { const img = d.getElementById('avatarPreview'); if (img) img.src = e.target.result; };
                        reader.readAsDataURL(f);
                    });
                }
                const formAvatar = d.getElementById('changeAvatarForm');
                if (formAvatar) {
                    formAvatar.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const err = d.getElementById('changeAvatarAlert');
                        if (err) { err.textContent = ''; err.style.display = 'none'; }

                        const f = fileInput && fileInput.files && fileInput.files[0];
                        if (!f) { if (err) { err.textContent = 'Selecciona una imagen.'; err.style.display = 'block'; } return; }

                        const fd = new FormData();
                        fd.append('avatar', f);

                        $.ajax({
                            url: '@Url.Action("ActualizarFotoPerfil", "Acceso")',
                            type: 'POST',
                            processData: false,
                            contentType: false,
                            headers: { 'RequestVerificationToken': csrf() },
                            data: fd,
                            success: function (resp) {
                                if (resp && resp.success) {
                                    $('#changeAvatarModal').modal('hide');

                                    if (resp.url) {
                                        const newUrl = bump(resp.url);
                                        const top = d.getElementById('topAvatar');
                                        const dd = d.getElementById('dropdownAvatar');
                                        const prev = d.getElementById('avatarPreview');

                                        if (top) top.src = newUrl;
                                        if (dd) dd.src = newUrl;
                                        if (prev) prev.src = newUrl;
                                    }

                                    $('#genericSuccessLine1').text('Operación exitosa');
                                    $('#genericSuccessLine2').text(resp.message || 'Foto de perfil actualizada.');

                                    $('#genericSuccessModal').modal('show');

                                    setTimeout(function () {
                                        $('#genericSuccessModal').modal('hide');
                                    }, 1800);
                                } else {
                                    if (err) { err.textContent = (resp && resp.message) || 'No se pudo actualizar la foto.'; err.style.display = 'block'; }
                                }
                            },
                            error: function () { if (err) { err.textContent = 'Error de red/servidor.'; err.style.display = 'block'; } }
                        });
                    });
                }

                /* === Logout === */
                const btnLogout2 = d.getElementById('btnLogoutDropdown');
                if (btnLogout2) {
                    btnLogout2.addEventListener('click', function (e) {
                        e.preventDefault(); e.stopPropagation();
                        $('#logoutConfirmModal').modal({ backdrop: 'static', keyboard: false, show: true });
                    });
                }
                const btnConfirmLogout = d.getElementById('btnConfirmLogoutModal');
                if (btnConfirmLogout) {
                    btnConfirmLogout.addEventListener('click', function () {
                        const spinner = this.querySelector('.spinner-border');
                        this.disabled = true;
                        if (spinner) spinner.classList.remove('d-none');

                        fetch('/Acceso/CerrarSesion', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': csrf() },
                            credentials: 'same-origin'
                        }).finally(() => {
                            window.location.href = '/Home/Index';
                        });
                    });
                }

                /* === Título dinámico + resaltar menú === */
                const headerTitle = d.getElementById('headerSectionTitle');
                const menuLinks = Array.from(d.querySelectorAll('.menu-link'));
                const here = window.location.pathname;

                let best = null; let bestLen = -1;
                for (const link of menuLinks) {
                    const linkPath = new URL(link.href, window.location.origin).pathname;
                    if (here === '/' && (link.dataset.section || '').toLowerCase() === 'inicio') {
                        best = link; bestLen = 9999; break;
                    }
                    if (here.startsWith(linkPath) && linkPath.length > bestLen && linkPath !== '/') {
                        best = link; bestLen = linkPath.length;
                    }
                }
                if (best) {
                    best.classList.add('active-menu');
                    const sub = best.closest('.submenu');
                    if (sub) {
                        sub.classList.add('show');
                        const btn = document.querySelector('[data-target="#' + sub.id + '"]');
                        if (btn) btn.classList.remove('collapsed');
                    }
                    const section = (best.dataset.section || '').trim();
                    const subm = (best.dataset.submenu || '').trim();
                    headerTitle.textContent =
                        (!subm || section.toLowerCase() === 'inicio')
                        ? (section || 'Inicio')
                        : (section + ' / ' + subm);
                } else {
                    headerTitle.textContent = 'Inicio';
                }

                $(document).on('show.bs.collapse hide.bs.collapse', '.submenu', function (e) {
                    var $btn = $(this).prev('.menu-section');
                    if (!$btn.length) return;
                    if (e.type === 'show') $btn.removeClass('collapsed');
                    if (e.type === 'hide') $btn.addClass('collapsed');
                });

                menuLinks.forEach(l => l.addEventListener('click', function () {
                    menuLinks.forEach(x => x.classList.remove('active-menu'));
                    this.classList.add('active-menu');
                    const section = (this.dataset.section || '').trim();
                    const subm = (this.dataset.submenu || '').trim();
                    headerTitle.textContent =
                        (!subm || section.toLowerCase() === 'inicio')
                        ? (section || 'Inicio')
                        : (section + ' / ' + subm);
                }));

                // Calcular offsets al cargar
                setSafeOffset();
                setSidebarWidthVar();
            });

            // Recalcular en resize
            window.addEventListener('resize', function () {
                setSafeOffset();
                setSidebarWidthVar();
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
